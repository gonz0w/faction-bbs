use faction_core::{Board, Error, RoamingAdmission, RoamingRegistry, Status, request_id};
use std::{fs,path::PathBuf};
struct Fixture { path:PathBuf, board:Board, secret:String }
impl Fixture {
 fn new()->Self { let path=std::env::temp_dir().join(format!("faction223-core-OWNED-{}",request_id().unwrap())); let mut board=Board::open(&path).unwrap(); let secret=request_id().unwrap(); board.bootstrap("sysop",&secret).unwrap(); board.register("member",&secret).unwrap(); let root=board.authenticate("sysop",&secret).unwrap(); board.set_status(&root,"member",Status::Approved).unwrap(); Self{path,board,secret} }
 fn binding(&mut self,uid:u32)->i64 { let issuer=self.board.roaming_add_issuer("home-one","SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA").unwrap(); let issuer=self.board.roaming_set_issuer_enabled(issuer.id,issuer.generation,true).unwrap(); let member=self.board.roaming_owner_member_id("member").unwrap(); let b=self.board.roaming_link_member(issuer.id,issuer.generation,"stable-subject","board-one:home-one:stable-subject",member,uid,"local-consent-223").unwrap(); self.board.roaming_set_binding_enabled(b.id,b.generation,true).unwrap().id }
 fn install(&mut self) { self.board=Board::open(&self.path).unwrap(); let s=self.board.roaming_owner_state().unwrap(); self.board.configure_roaming_owner(Some(RoamingRegistry {board_identity:s.board_identity,entries:s.bindings.iter().filter(|b|b.enabled).map(|b|RoamingAdmission{uid:b.uid,binding_id:b.id,binding_generation:b.generation,issuer_generation:s.issuers.iter().find(|i|i.id==b.issuer_id).unwrap().generation}).collect()})).unwrap(); }
}
impl Drop for Fixture { fn drop(&mut self) { let _=fs::remove_dir_all(&self.path); } }
#[test]
fn owner_registry_authenticates_real_sessions_and_revokes_exact_provenance() {
 let mut f=Fixture::new(); assert!(f.board.authenticate_roaming_uid(42001).is_err()); let id=f.binding(42001); f.install();
 let roaming=f.board.authenticate_roaming_uid(42001).unwrap(); let password=f.board.authenticate("member",&f.secret).unwrap(); assert_eq!(f.board.whoami(&roaming).unwrap().handle,"member"); assert_eq!(f.board.rooms(&roaming).unwrap().len(),1); assert!(f.board.authenticate_roaming_uid(42002).is_err());
 let mut run=f.board.game_start(&roaming,"fixture").unwrap(); let mut ordinary=f.board.game_start(&password,"fixture").unwrap(); let lease=f.board.chat_open(&roaming).unwrap(); let plain_lease=f.board.chat_open(&password).unwrap();
 let b=f.board.roaming_owner_state().unwrap().bindings.into_iter().find(|b|b.id==id).unwrap(); f.board.roaming_set_binding_enabled(id,b.generation,false).unwrap();
 assert!(f.board.whoami(&roaming).is_err()); assert!(f.board.rooms(&roaming).is_err()); assert!(f.board.game_finish(&password,&mut run,3).is_err()); assert!(f.board.chat_heartbeat(&lease).is_err()); f.board.chat_heartbeat(&plain_lease).unwrap(); f.board.game_finish(&password,&mut ordinary,3).unwrap(); assert!(f.board.rooms(&password).is_ok());
 let b=f.board.roaming_owner_state().unwrap().bindings.remove(0); f.board.roaming_set_binding_enabled(id,b.generation,true).unwrap(); assert!(f.board.authenticate_roaming_uid(42001).is_err()); assert!(f.board.whoami(&roaming).is_err());
}
#[test]
fn owner_registry_is_once_before_auth_and_rejects_wrong_board_or_generation() {
 let mut f=Fixture::new(); f.binding(42001); let state=f.board.roaming_owner_state().unwrap(); assert!(f.board.configure_roaming_owner(Some(RoamingRegistry{board_identity:[0;32],entries:vec![]})).is_err());
 // Setup has password-authenticated; use a fresh owner handle before installing.
 let mut fresh=Board::open(&f.path).unwrap(); let b=&state.bindings[0]; let i=&state.issuers[0]; assert!(fresh.configure_roaming_owner(Some(RoamingRegistry{board_identity:state.board_identity,entries:vec![RoamingAdmission{uid:b.uid,binding_id:b.id,binding_generation:b.generation+1,issuer_generation:i.generation}]})).is_err());
 f.board=Board::open(&f.path).unwrap(); f.install(); assert!(f.board.configure_roaming_owner(None).is_err()); let s=f.board.authenticate_roaming_uid(42001).unwrap(); let root=f.board.authenticate("sysop",&f.secret).unwrap(); f.board.set_status(&root,"member",Status::Revoked).unwrap(); assert!(matches!(f.board.whoami(&s),Err(Error::StaleSession)|Err(Error::Denied))); assert!(f.board.authenticate_roaming_uid(42001).is_err());
}
#[test]
fn issuer_revoke_disables_bindings_and_export_carries_no_enabled_authority() {
 let mut f=Fixture::new(); f.binding(42001);f.install();let old=f.board.roaming_owner_state().unwrap();
 let export=f.path.join("disabled-authority-export.sqlite3");f.board.export_local(&export).unwrap();let db=rusqlite::Connection::open(&export).unwrap();
 assert_eq!(db.query_row("SELECT count(*) FROM roaming_bindings WHERE enabled=1",[],|r|r.get::<_,i64>(0)).unwrap(),0);
 assert_eq!(db.query_row("SELECT count(*) FROM roaming_issuers WHERE enabled=1",[],|r|r.get::<_,i64>(0)).unwrap(),0);
 let issuer=&old.issuers[0];f.board.roaming_set_issuer_enabled(issuer.id,issuer.generation,false).unwrap();let next=f.board.roaming_owner_state().unwrap();assert!(!next.bindings[0].enabled);assert!(next.bindings[0].generation>old.bindings[0].generation);
 let issuer=&next.issuers[0];f.board.roaming_set_issuer_enabled(issuer.id,issuer.generation,true).unwrap();assert!(!f.board.roaming_owner_state().unwrap().bindings[0].enabled);
}
#[test]
fn issuer_disablement_rotates_every_binding_before_reenable() {
 let mut f=Fixture::new();f.binding(42001);let old=f.board.roaming_owner_state().unwrap();let i=&old.issuers[0];f.board.roaming_set_issuer_enabled(i.id,i.generation,false).unwrap();let next=f.board.roaming_owner_state().unwrap();assert!(!next.bindings[0].enabled);assert!(next.bindings[0].generation>old.bindings[0].generation);
}
