"""Issue226 signer qualification requires independent proofs and normal exits."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch
import probe_roaming_signer as probe

KEYGEN = Path('/usr/bin/ssh-keygen')


class RoamingSigner(unittest.TestCase):
    def test_strict_success_and_denial(self):
        for code in (-11, None, 1):
            self.assertFalse(probe.Command(code).success)
        self.assertTrue(probe.Command(0).success)
        self.assertTrue(probe.Command(1).denied)
        for code in (-11, None, 0):
            self.assertFalse(probe.Command(code).denied)
        self.assertFalse(probe.Command(0, output_limited=True).success)
        self.assertFalse(probe.Command(1, timed_out=True).denied)

    def test_real_profile_five_issuances_and_all_negatives(self):
        with tempfile.TemporaryDirectory() as parent:
            result = probe.run(KEYGEN, KEYGEN, Path(parent))
            self.assertEqual(result['result'], 'qualified')
            self.assertTrue(result['overall_qualification'])
            self.assertEqual(result['valid_issuance_count'], 5)
            self.assertEqual(len(result['controls']), 5)
            for control in result['controls']:
                for field in ('accepted', 'independently_parsed', 'signature_verified',
                              'reuse_verified', 'wrong_ca_denied', 'wrong_principal_denied',
                              'wrong_private_key_denied', 'tamper_denied'):
                    self.assertTrue(control[field], (field, control))
            for field in ('expired_denied', 'future_denied', 'missing_ca_denied',
                          'fixture_setup_complete', 'keys_removed', 'core_dumps_disabled'):
                self.assertTrue(result[field], field)
            self.assertEqual(list(Path(parent).iterdir()), [])
            raw = json.dumps(result)
            for private in ('BEGIN OPENSSH', 'ssh-ed25519 ', 'board-a/home-a/subject-a', parent,
                            'stdout', 'stderr'):
                self.assertNotIn(private, raw)

    def test_artifact_after_signer_crash_is_rejected_without_verification(self):
        original = probe._run
        parsed = []
        def crash(argv, data=None):
            outcome = original(argv, data)
            if '-s' in argv:
                return probe.Command(-11)
            if '-L' in argv:
                parsed.append(argv)
            return outcome
        with patch.object(probe, '_run', side_effect=crash):
            result = probe.run(KEYGEN, KEYGEN)
        self.assertEqual(result['result'], 'rejected')
        self.assertFalse(result['overall_qualification'])
        self.assertTrue(all(c['artifact_produced'] and not c['accepted'] for c in result['controls']))
        self.assertEqual(parsed, [])

    def test_abnormal_negative_verifier_is_not_denial(self):
        original = probe._run
        def crash(argv, data=None):
            if '-Y' in argv and 'verify' in argv and '-I' in argv and argv[argv.index('-I')+1] == 'other-board/home-a/subject-a':
                return probe.Command(-11)
            return original(argv, data)
        with patch.object(probe, '_run', side_effect=crash):
            result = probe.run(KEYGEN, KEYGEN)
        self.assertEqual(result['result'], 'rejected')
        self.assertTrue(all(not c['wrong_principal_denied'] for c in result['controls']))

    def test_parsing_is_an_independent_required_gate(self):
        original = probe._run
        def malformed(argv, data=None):
            if '-L' in argv:
                return probe.Command(0, stdout=b'not a certificate listing')
            return original(argv, data)
        with patch.object(probe, '_run', side_effect=malformed):
            result = probe.run(KEYGEN, KEYGEN)
        self.assertEqual(result['result'], 'rejected')
        self.assertTrue(all(not c['independently_parsed'] for c in result['controls']))

    def test_timeout_and_output_limit_are_bounded_failures(self):
        slow = probe._run([sys.executable, '-c', 'import time; time.sleep(3)'], timeout=.05)
        self.assertTrue(slow.timed_out)
        self.assertFalse(slow.success or slow.denied)
        loud = probe._run([sys.executable, '-c', 'import os; os.write(1,b"x"*200000)'], output_limit=4096)
        self.assertTrue(loud.output_limited)
        self.assertLessEqual(len(loud.stdout) + len(loud.stderr), 4096)
        self.assertFalse(loud.success or loud.denied)

    def test_agent_environment_is_removed(self):
        with patch.dict(os.environ, {'SSH_AUTH_SOCK':'secret', 'SSH_AGENT_PID':'123', 'SSH_ASKPASS':'secret'}):
            outcome = probe._run([sys.executable, '-c', 'import os; print(any(k in os.environ for k in ("SSH_AUTH_SOCK","SSH_AGENT_PID","SSH_ASKPASS")))'])
        self.assertTrue(outcome.success)
        self.assertEqual(outcome.stdout.strip(), b'False')

    def test_setup_failure_is_reported_and_keys_removed(self):
        with tempfile.TemporaryDirectory() as parent, patch.object(probe, '_run', return_value=probe.Command(None, unavailable=True)):
            result = probe.run(KEYGEN, KEYGEN, Path(parent))
            self.assertEqual(result['result'], 'rejected')
            self.assertFalse(result['fixture_setup_complete'])
            self.assertEqual(result['failure_layer'], 'fixture_setup')
            self.assertTrue(result['keys_removed'])
            self.assertEqual(list(Path(parent).iterdir()), [])

    def test_absolute_paths_and_unprivileged_execution_required(self):
        with self.assertRaises(ValueError):
            probe.run(Path('ssh-keygen'), KEYGEN)
        with patch.object(probe.os, 'geteuid', return_value=0):
            with self.assertRaises(PermissionError):
                probe.run(KEYGEN, KEYGEN)

    def test_cli_observation_exit_zero_does_not_imply_qualification(self):
        with tempfile.TemporaryDirectory() as tmp:
            output = Path(tmp)/'observations.json'
            completed = subprocess.run([sys.executable, str(Path(probe.__file__)),
                '--disposable-synthetic-fixture', '--candidate', '/usr/bin/false',
                '--verifier', str(KEYGEN), '--output', str(output)], capture_output=True, timeout=30)
            self.assertEqual(completed.returncode, 0)
            result = json.loads(output.read_text())
            self.assertEqual(result['result'], 'rejected')
            self.assertFalse(result['overall_qualification'])

    def test_hashing_works_without_python311_file_digest(self):
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp)/'binary'
            path.write_bytes(b'fixture executable bytes')
            expected = probe.hashlib.sha256(path.read_bytes()).hexdigest()
            with patch.dict(probe.hashlib.__dict__):
                del probe.hashlib.file_digest
                self.assertEqual(probe._digest(path), expected)

    def test_fourth_keygen_exit_zero_without_artifacts_is_setup_failure(self):
        original = probe._run
        def missing_artifacts(argv, data=None):
            if '-t' in argv and Path(argv[-1]).name == 'wrong-device':
                return probe.Command(0)
            return original(argv, data)
        with tempfile.TemporaryDirectory() as parent, patch.object(probe, '_run', side_effect=missing_artifacts):
            result = probe.run(KEYGEN, KEYGEN, Path(parent))
            self.assertFalse(result['fixture_setup_complete'])
            self.assertFalse(result['overall_qualification'])
            self.assertEqual(result['failure_layer'], 'fixture_setup')
            self.assertTrue(result['keys_removed'])
            self.assertEqual(list(Path(parent).iterdir()), [])

    def test_child_exit_without_reading_stdin_is_reaped(self):
        outcome = probe._run(['/usr/bin/false'], b'x'*4096)
        self.assertTrue(outcome.denied)

    def test_unexpected_exception_removes_private_fixture(self):
        def interrupted(argv, data=None):
            Path(argv[-1]).write_text('synthetic private fixture marker')
            raise RuntimeError('controlled exception')
        with tempfile.TemporaryDirectory() as parent, patch.object(probe, '_run', side_effect=interrupted):
            with self.assertRaisesRegex(RuntimeError, 'controlled exception'):
                probe.run(KEYGEN, KEYGEN, Path(parent))
            self.assertEqual(list(Path(parent).iterdir()), [])
