#!/usr/bin/env python3
"""Directory moderation over real restricted SSH/native clients in an owned guest."""
import argparse,hashlib,json,shlex,subprocess,time
from pathlib import Path
from check_restricted_ssh import SSHConsole
from smoke_native_client_ssh import NativeConsole
from smoke_directory import FOOTER


def run(a):
    assert a.disposable_fixture
    settings=json.loads(a.settings.read_text());assert settings['disposable_fixture']
    assert settings['database']=='/var/db/faction184-board/faction.sqlite3'
    admin=settings['admin_argv'];member=settings['member_argv'];password=settings['sysop_password']
    children=[];checks=[];calls=0;pack='/var/db/faction184-directory';config='/etc/faction/service.toml'
    def remote(command,data=None):
        r=subprocess.run(admin+['set -e; PATH=/usr/pkg/bin:/usr/bin:/bin:/usr/sbin:/sbin; export PATH; test -f /etc/faction-disposable-test; '+command],input=data,capture_output=True,timeout=40)
        assert r.returncode==0,'owned shared directory fixture command failed; private diagnostics only'
        return r.stdout
    def query(sql):
        code='import sqlite3,json; d=sqlite3.connect('+repr(settings['database'])+'); print(json.dumps(d.execute('+repr(sql)+').fetchall()))'
        return json.loads(remote('/usr/pkg/bin/python3.13 -c '+shlex.quote(code)))
    original=remote('cat '+config).decode();assert not any(line.strip().startswith('directory =') for line in original.splitlines())
    def configure(plain=False):
        remote('/etc/rc.d/faction_broker onestop')
        data=original.replace('ansi = true','ansi = false') if plain else original
        assert not plain or 'ansi = false' in data
        data+='\ndirectory = "'+pack+'"\n'
        remote('cat > '+config+'; chown root:factionipc '+config+'; chmod 640 '+config,data.encode())
        remote('/etc/rc.d/faction_broker onestart')
    def connect(native=False,plain=False,compact=False):
        nonlocal calls
        if calls:time.sleep(5.1)
        calls+=1
        c=NativeConsole([str(a.native_binary.resolve()),'--profile',settings['profile']]) if native else SSHConsole(member,columns=40 if compact else 80,rows=18 if compact else 24)
        children.append(c);c.expect('[L]ogin [R]egister [Q]uit: ');c.send('l');c.expect('Handle: ');c.send('sysop');c.password(password)
        if compact:c.expect(FOOTER)
        else:c.expect('Press Enter to continue: ');c.send('');c.expect('Command (then Enter): ' if plain else FOOTER)
        return c
    def desk(c,plain=False):
        c.send('o') if plain else c.raw(b'o');c.expect('Directory command: ' if plain else 'Independent login/approval required.')
        c.send('s') if plain else c.raw(b's');c.expect('Directory submissions');c.expect('Submission command: ')
    def cmd(c,value,prompt='Submission command: '):c.send(value);c.expect(prompt)
    def back(c,plain=False):
        cmd(c,'q','Directory command: ' if plain else 'Independent login/approval required.')
        c.send('q') if plain else c.raw(b'q');c.expect('Command (then Enter): ' if plain else FOOTER)
    def quit(c,plain=False):
        c.send('q') if plain else c.raw(b'q');c.expect('Logged out.');c.finish()
    def draft(c,cancel=False):
        cmd(c,'n','Slug: ')
        values=[('night-radio','Name: '),('Midnight Radio','Summary: '),('Independent rooms and original art','SSH host: '),('radio.example','SSH port: '),('2222','SSH login: '),('bbs','Public fingerprint (blank: none): '),('','Draft preview / not saved')]
        for value,prompt in values:cmd(c,value,prompt)
        c.expect('Submission command: ')
        if cancel:cmd(c,'c','Unsaved listing cancelled.');c.expect('Submission command: ')
        else:cmd(c,'s','Private draft saved;');c.expect('Submission command: ')
    try:
        remote('/etc/rc.d/faction_broker onestop; test ! -e '+pack+'; install -d -o factiond -g factionipc -m 700 '+pack)
        source=b'version=1\nboards=[]\n'
        remote('cat > '+pack+'/boards.toml; chown factiond:factionipc '+pack+'/boards.toml; chmod 600 '+pack+'/boards.toml',source)
        assert query('SELECT count(*) FROM directory_submissions')==[[0]]
        configure();remote('/etc/rc.d/faction_sshd onestart')
        c=connect();desk(c);draft(c,True);assert query('SELECT count(*) FROM directory_submissions')==[[0]];draft(c);cmd(c,'s','Submitted pending sysop review.');c.expect('Submission command: ');assert query('SELECT state FROM directory_submissions')==[['pending']];back(c);quit(c);checks.append('restricted_ssh_cancel_save_and_submit_never_publish')
        c=connect(native=True);desk(c);cmd(c,'m');cmd(c,'1');cmd(c,'a','Reviewed date: ');cmd(c,'2026-10-26','Valid until date: ');cmd(c,'2099-10-26');cmd(c,'APPROVE');assert query('SELECT state FROM directory_submissions')==[['published']];back(c);c.raw(b'o');c.expect('Midnight Radio');c.raw(b'a');c.expect('Connection card 1 / 1');c.expect('Locally moderated member submission.');c.raw(b'q');c.expect(FOOTER);quit(c);checks.append('native_client_exact_sysop_approval_and_published_card')
        watcher=connect(compact=True);watcher.raw(b'o');watcher.expect('Midnight Radio');watcher.raw(b'a');watcher.expect('Connection card 1 / 1')
        c=connect();desk(c);cmd(c,'m');cmd(c,'1');cmd(c,'e');cmd(c,'EXPIRE');assert query('SELECT state FROM directory_submissions')==[['expired']];cmd(c,'1');cmd(c,'x');cmd(c,'REMOVE');assert query('SELECT count(*) FROM directory_submissions')==[[0]];back(c);quit(c);checks.append('shared_sysop_expiry_and_removal_use_current_revision')
        watcher.raw(b'\r');watcher.expect('No boards listed yet. Ask the sysop.');assert b'Connection card' not in watcher.buffer;watcher.raw(b'q');watcher.expect(FOOTER);quit(watcher);checks.append('concurrent_card_removal_consumes_old_selection_without_endpoint_swap')
        configure(True);c=connect(plain=True);desk(c,True);draft(c,True);assert query('SELECT count(*) FROM directory_submissions')==[[0]];back(c,True);quit(c,True);assert b'\x1b' not in c.transcript;checks.append('plain_shared_submit_preview_cancel_and_return_without_ansi')
        assert remote('cat '+pack+'/boards.toml')==source;assert query('PRAGMA user_version')==[[19]]
        assert all(password.encode() not in c.transcript for c in children);checks.append('owner_pack_unchanged_schema_nineteen_and_no_password_echo')
        result={'result':'pass','count':len(checks),'checks':checks,'schema_version':19,'normal_sessions':8,'admission_refill_ms':5000,'capacity_claim':False,'hardening_claim':False,'federation_claim':False}
        a.output.write_text(json.dumps(result,indent=2)+'\n');print('Shared SSH/native directory submissions passed:',len(checks),'controls.')
    finally:
        for c in children:c.close()
        remote('/etc/rc.d/faction_broker onestop || true')

if __name__=='__main__':
    p=argparse.ArgumentParser(description=__doc__);p.add_argument('--disposable-fixture',action='store_true',required=True)
    for n in ['settings','native-binary','output']:p.add_argument('--'+n,type=Path,required=True)
    run(p.parse_args())
