#[test]
fn simultaneous_submission_reserves_one_endpoint_and_stale_other_writer_fails() {
 use std::sync::{Arc,Barrier};
 let f=Fixture::new();let(mut b,s)=f.board();let a=f.member(&mut b,&s,"alice");let one=save(&mut b,&a,1);let two=save(&mut b,&a,1);let ids=[one,two];let revisions=ids.map(|id|b.directory_submission(&a,id).unwrap().revision);let barrier=Arc::new(Barrier::new(2));let mut handles=vec![];
 for(i,id)in ids.into_iter().enumerate(){let path=f.0.join("board");let barrier=barrier.clone();let r=revisions[i].clone();handles.push(std::thread::spawn(move||{let mut b=Board::open(&path).unwrap();b.configure_directory_owner(Some(vec![])).unwrap();let s=b.authenticate("alice",PASS).unwrap();barrier.wait();b.directory_submit(&s,id,&r).is_ok()}));}
 assert_eq!(handles.into_iter().map(|h|h.join().unwrap()).filter(|ok|*ok).count(),1);let pending=b.directory_submissions(&a,0).unwrap().into_iter().find(|r|r.state=="pending").unwrap();let mut other=Board::open(&f.0.join("board")).unwrap();other.configure_directory_owner(Some(vec![])).unwrap();let os=other.authenticate("sysop",PASS).unwrap();approve(&mut other,&os,pending.id,&pending.revision);assert!(b.directory_review(&s,pending.id,&pending.revision,"reject",None,None).is_err());assert_eq!(b.directory_published(&s).unwrap().len(),1);
}
#[test]
fn snapshot_rejects_revision_dates_state_bounds_duplicates_and_extra_schema() {
 let f=Fixture::new();let(mut b,s)=f.board();let id=save(&mut b,&s,1);let r=submit(&mut b,&s,id);approve(&mut b,&s,id,&r);
 let attacks=["UPDATE directory_submissions SET revision='BAD'","UPDATE directory_submissions SET nonce='BAD'","UPDATE directory_submissions SET valid_until='2026-02-30'","UPDATE directory_submissions SET state='pending'","UPDATE directory_submissions SET port=0","UPDATE directory_submissions SET summary=char(27)||'[2J'","INSERT INTO directory_submissions SELECT 2,author,'0123456789abcdef0123456789abcdef',revision,state,slug,name,summary,host,port,login,fingerprint,reviewed,valid_until FROM directory_submissions","CREATE TABLE unexpected_directory_data(secret TEXT)","UPDATE directory_submissions SET reviewed='2027-01-01'","UPDATE directory_submissions SET state='unknown'"];
 for(i,sql)in attacks.iter().enumerate(){let path=f.0.join(format!("bad-{i}.sqlite3"));b.export_local(&path).unwrap();let db=rusqlite::Connection::open(&path).unwrap();db.execute_batch("PRAGMA ignore_check_constraints=ON").unwrap();db.execute_batch(sql).unwrap();drop(db);assert!(verify_export(&path).is_err(),"accepted {sql}");let target=f.0.join(format!("bad-restore-{i}"));assert!(restore_local(&path,&target).is_err());assert!(!target.exists());}
 let path=f.0.join("quota.sqlite3");b.export_local(&path).unwrap();let db=rusqlite::Connection::open(&path).unwrap();db.execute_batch("WITH RECURSIVE n(x) AS (VALUES(2) UNION ALL SELECT x+1 FROM n WHERE x<33) INSERT INTO directory_submissions SELECT x,1,printf('%032x',x),printf('%032x',x),'published','board-'||x,'Board','Summary','board'||x||'.example',22,'bbs',NULL,'2026-01-01','2026-12-31' FROM n").unwrap();drop(db);assert!(verify_export(&path).is_err());
}
