#[test]
fn published_capacity_includes_hidden_expired_and_curator_rows() {
 let f=Fixture::new();let(mut b,s)=f.board();let a=f.member(&mut b,&s,"alice");
 for n in 0..32 {let id=save(&mut b,&a,n);let r=submit(&mut b,&a,id);approve(&mut b,&s,id,&r);}
 let rows=b.directory_published(&s).unwrap();assert_eq!(rows.len(),32);let p=&rows[0];b.directory_review(&s,p.id,&p.revision,"expire",None,None).unwrap();assert_eq!(b.directory_published(&s).unwrap().len(),32);
 b.set_status(&s,"alice",Status::Revoked).unwrap();assert!(b.directory_published(&s).unwrap().is_empty());let id=save(&mut b,&s,100);let r=submit(&mut b,&s,id);assert!(b.directory_review(&s,id,&r,"approve",Some("2026-01-01"),Some("2026-12-31")).is_err());
 let mut over=Board::open(&f.0.join("board")).unwrap();assert!(over.configure_directory_owner(Some(vec![DirectoryKey{slug:"curator".into(),host:"curator.example".into(),port:22,login:"bbs".into()}])).is_err());
 let mut dup=Board::open(&f.0.join("board")).unwrap();let k=DirectoryKey{slug:"same".into(),host:"same.example".into(),port:22,login:"bbs".into()};assert!(dup.configure_directory_owner(Some(vec![k.clone(),k])).is_err());
