//! Selected bounded own-archive MAM2 page; metadata grants no device trust.
use crate::{mail_checkpoint::Wire, mail_wire::Binding};
use faction_xmpp::Element;
use std::io;
pub const MAM: &str = "urn:xmpp:mam:2";
pub const RSM: &str = "http://jabber.org/protocol/rsm";
pub struct Query<'a> {
    pub iq_id: &'a str,
    pub query_id: &'a str,
    pub own: &'a str,
    pub full: &'a str,
    pub peer: &'a str,
    pub after: Option<&'a str>,
}
#[derive(Debug)]
pub struct Entry { pub id: String, pub wire: Wire }
pub fn query(_q: &Query<'_>) -> io::Result<Element> { Err(crate::mail_data::invalid()) }
pub fn result(_xml: &Element, _q: &Query<'_>, _binding: Binding<'_>, _identity: [u8;32]) -> io::Result<Entry> { Err(crate::mail_data::invalid()) }
pub fn fin(_xml: &Element, _q: &Query<'_>, _entries: &[Entry]) -> io::Result<bool> { Err(crate::mail_data::invalid()) }

#[cfg(test)]
mod tests {
    use super::*;
    fn q() -> Query<'static> { Query { iq_id:"iq-random", query_id:"query-random", own:"bob@home.test", full:"bob@home.test/faction202", peer:"alice@away.test", after:Some("opaque:previous") } }
    fn binding() -> Binding<'static> { Binding { peer:"alice@away.test", peer_device:101, peer_identity:[11;32], own:"bob@home.test", own_device:202 } }
    fn wire() -> Wire { Wire { namespace:crate::mail_wire::OMEMO.into(), from:"alice@away.test".into(), to:"bob@home.test".into(), device:101, to_device:202, identity:[11;32], sent_at:0, key:vec![1], prekey:true, payload:vec![0;16] } }
    fn wrapper(wire: &Wire, id: &str) -> Element {
        Element::builder("message", "jabber:client").attr("to".try_into().unwrap(),q().full).append(
            Element::builder("result", MAM).attr("queryid".try_into().unwrap(),q().query_id).attr("id".try_into().unwrap(),id).append(
                Element::builder("forwarded","urn:xmpp:forward:0")
                    .append(Element::builder("delay","urn:xmpp:delay").attr("stamp".try_into().unwrap(),"2026-10-25T12:00:00.123Z").build())
                    .append(crate::mail_wire::message(wire,[1;16]).unwrap()).build()).build()).build()
    }
    fn finish(ids: &[&str], complete: &str, extra: &str) -> Element {
        let bounds = if ids.is_empty() { String::new() } else { format!("<first index='0'>{}</first><last>{}</last>", ids[0],ids[ids.len()-1]) };
        format!("<iq xmlns='jabber:client' type='result' id='iq-random'><fin xmlns='{MAM}' complete='{complete}'><set xmlns='{RSM}'>{bounds}{extra}</set></fin></iq>").parse().unwrap()
    }
    fn entries(ids: &[&str]) -> Vec<Entry> { ids.iter().map(|id|Entry{id:(*id).into(),wire:wire()}).collect() }
    fn text(e:&Element)->String { let mut out=Vec::new(); e.write_to(&mut out).unwrap(); String::from_utf8(out).unwrap() }
    #[test]
    fn request_is_own_archive_peer_filtered_and_four_bounded() {
        let xml=query(&q()).unwrap();
        assert_eq!(xml.attr("to"),Some(q().own)); assert_eq!(xml.attr("id"),Some(q().iq_id));
        let query=xml.get_child("query",MAM).unwrap(); assert_eq!(query.attr("queryid"),Some(q().query_id));
        let set=query.get_child("set",RSM).unwrap(); assert_eq!(set.get_child("max",RSM).unwrap().text(),"4");
        assert_eq!(set.get_child("after",RSM).unwrap().text(),"opaque:previous");
        let x=query.get_child("x","jabber:x:data").unwrap();
        assert!(x.children().any(|e|e.attr("var")==Some("with")&&e.children().next().unwrap().text()==q().peer));
        assert!(x.children().any(|e|e.attr("var")==Some("FORM_TYPE")&&e.children().next().unwrap().text()==MAM));
    }
    #[test]
    fn opaque_cursor_and_query_inputs_are_bounded() {
        for bad in ["", "contains space", "control\n", &"x".repeat(257)] { let mut context=q();context.after=Some(bad);assert!(query(&context).is_err()); }
        let mut context=q(); context.after=Some("!~<>:&'\""); assert!(query(&context).is_ok());
        context.after=None; assert!(query(&context).unwrap().get_child("query",MAM).unwrap().get_child("set",RSM).unwrap().get_child("after",RSM).is_none());
        context.full="bob@home.test/other/extra"; assert!(query(&context).is_err());
    }
    #[test]
    fn incoming_uses_enrolled_identity_and_ignores_server_time() {
        let got=result(&wrapper(&wire(),"archive:first"),&q(),binding(),[22;32]).unwrap();
        assert_eq!(got.id,"archive:first");assert_eq!(got.wire,wire());assert_eq!(got.wire.sent_at,0);
    }
    #[test]
    fn own_sent_echo_uses_swapped_trusted_binding_without_decryption() {
        let mut own=wire(); own.from=q().own.into();own.to=q().peer.into();own.device=202;own.to_device=101;own.identity=[22;32];
        let got=result(&wrapper(&own,"own:sent"),&q(),binding(),[22;32]).unwrap();assert_eq!(got.wire,own);
    }
    #[test]
    fn wrong_owner_query_shape_namespace_addresses_and_delay_are_rejected() {
        let original=text(&wrapper(&wire(),"archive:first"));
        for bad in [
            original.replacen("<message ","<message from='mallory@home.test' ",1),
            original.replace("bob@home.test/faction202","bob@home.test/faction999"),
            original.replace("query-random","wrong-query"),
            original.replace("urn:xmpp:forward:0","urn:wrong:forward"),
            original.replace("2026-10-25T12:00:00.123Z","2026-02-30T25:00:00Z"),
            original.replace("2026-10-25T12:00:00.123Z","2026-10-25T12:00:00+00:00"),
            original.replace("archive:first",&"x".repeat(257)),
            original.replace("</result>","<forwarded xmlns='urn:xmpp:forward:0'/></result>"),
            original.replace("</message>","<body>plaintext</body></message>"),
        ] { assert!(result(&bad.parse().unwrap(),&q(),binding(),[22;32]).is_err(),"accepted {bad}"); }
    }
    #[test]
    fn fin_matches_only_iq_and_actual_first_last_not_total_count() {
        assert!(fin(&finish(&["a","b"],"true","<count>999</count>"),&q(),&entries(&["a","b"])).unwrap());
        assert!(!fin(&finish(&["a"],"false",""),&q(),&entries(&["a"])).unwrap());
        assert!(fin(&finish(&[],"true","<count>0</count>"),&q(),&[]).unwrap());
        assert!(!fin(&finish(&[],"false",""),&q(),&[]).unwrap());
        let without=text(&finish(&["a"],"true","")).replace("complete=\"true\"","");
        assert!(!fin(&without.parse().unwrap(),&q(),&entries(&["a"])).unwrap());
    }
    #[test]
    fn fin_rejects_mismatch_duplicates_extra_unstable_and_more_than_four() {
        let original=text(&finish(&["a","b"],"true",""));
        for bad in [original.replace("iq-random","other"),original.replace(">b<",">c<"),original.replace("<iq ","<iq from='home.test' "),original.replace("complete=\"true\"","complete='true' stable='false'"),original.replace("</fin>","<extra/></fin>"),original.replace("</set>","<first>a</first></set>")] {
            assert!(fin(&bad.parse().unwrap(),&q(),&entries(&["a","b"])).is_err(),"accepted {bad}");
        }
        assert!(fin(&finish(&["a","a"],"true",""),&q(),&entries(&["a","a"])).is_err());
        assert!(fin(&finish(&["a","b","c","d","e"],"true",""),&q(),&entries(&["a","b","c","d","e"])).is_err());
        assert!(fin(&finish(&["a"],"true",""),&q(),&[]).is_err());
    }
}
