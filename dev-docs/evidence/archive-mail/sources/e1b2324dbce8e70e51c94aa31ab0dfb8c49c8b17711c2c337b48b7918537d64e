    struct Scripted {
        reads: std::collections::VecDeque<(std::time::Duration, faction_xmpp::Element)>,
        sent: Vec<faction_xmpp::Element>,
    }
    impl Channel for Scripted {
        async fn send(&mut self, xml: &faction_xmpp::Element) -> Result<(), faction_xmpp::Error> {
            self.sent.push(xml.clone());
            Ok(())
        }
        async fn next(&mut self) -> Result<faction_xmpp::Element, faction_xmpp::Error> {
            let (delay, xml) = self.reads.pop_front().ok_or(faction_xmpp::Error::Lost)?;
            if !delay.is_zero() {
                tokio::time::sleep(delay).await;
            }
            Ok(xml)
        }
    }
    fn interleaved(message: faction_xmpp::Element, delay: std::time::Duration) -> Scripted {
        let empty = "<iq xmlns='jabber:client' type='error' id='own-devices'><error><item-not-found xmlns='urn:ietf:params:xml:ns:xmpp-stanzas'/></error></iq>".parse().unwrap();
        let ack = |id| {
            format!("<iq xmlns='jabber:client' type='result' id='{id}'/>")
                .parse()
                .unwrap()
        };
        Scripted {
            reads: [
                (delay, message),
                (std::time::Duration::ZERO, empty),
                (std::time::Duration::ZERO, ack("pub-bundle")),
                (std::time::Duration::ZERO, ack("pub-devices")),
            ]
            .into(),
            sent: vec![],
        }
    }
