from lab import *
import time

build=json.loads(remote('cat /home/factionbuild/proof228-final/native-build.json').stdout)
assert build['result']=='pass' and len(build['checks'])==3
(P/'native-build-final.json').write_text(json.dumps(build,indent=2)+'\n')
q=json.loads((V/'compile02-qemu-command.json').read_text())
pid=int((V/'compile02-qemu.pid').read_text())
cmd=subprocess.check_output(['ps','-p',str(pid),'-o','command='],text=True).strip()
