from pathlib import Path
import json,subprocess,time,pwd
assert Path('/etc/faction-disposable-test').is_file()
P=Path('/home/factionbuild/proof228');R=Path('/home/factionbuild/source228');B=Path('/usr/local/libexec/faction228');checks=[]
commands=[('classic-console-pty',['su','-m','factiond','-c',f'cd {R} && python3.13 tools/smoke_local_console.py {B}/faction']),('export-restore-pty',['su','-m','factiond','-c',f'cd {R} && python3.13 tools/smoke_export_restore.py {B}/faction']),('complete-bundle-recovery',['python3.13','tools/smoke_backup_recovery.py',str(B/'faction'),str(B/'faction-sysop'),'--owner-uid',str(pwd.getpwnam('factiond').pw_uid),'--files-uid',str(pwd.getpwnam('factionfiles').pw_uid),'--disposable-fixture','--output',str(P/'native-backup-recovery.json')])]
