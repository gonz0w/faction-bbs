    routes={}
    for route,platform in [('host','Darwin'),('netbsd','NetBSD')]:
        ui=dict(result='pass',platform=platform,count=17,checks=sorted(g.UI),private_fixture_removed=True,provider_contact=False,listener_opened=False)
        combined=dict(result='pass',platform=platform,scope='same-picker-unavailable-home-approved-board-restricted-sftp',count=8,checks=sorted(g.COMBINED),same_picker_pid=True,canonical_unchanged=True,history_unchanged=True,pending_ids_unchanged=True,archive_token_unchanged=True,nonempty_cursor=True,approved_member=True,restricted_sftp=True,payload_bytes=131328,payload_sha256=H,privacy_scan=dict(board_files=3,store_files=2,log_files=2,matches=0,symlinks=0),home_transport_error='Connect',physical_hardware=False,capacity_claim=False,private_fixture_retained_for_lead=True)
