fn cancellation_during_tls_reply_wait_joins_before_return_without_release() {
    let f = Fixture::new();
    let (mut a, b, epoch) = f.pair(false);
    let runtime = f.runtime(&a, &b);
    let mut spool = Spool::open(&f.root.join("outgoing")).unwrap();
    transfer::prepare(
        &mut a,
        &mut spool,
        [1; 16],
        selection(b"keep pending", epoch),
        epoch,
    )
    .unwrap();
    let settings = f.settings("alice@home.test", unused_endpoint());
    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
    let provider = f.provider(&a, 1, listener.local_addr().unwrap());
    thread::scope(|scope| {
        let (done, wait) = std::sync::mpsc::sync_channel(1);
        let (accepted, ready) = std::sync::mpsc::sync_channel(1);
        let fixture = &f;
        let owner = &runtime;
        let peer = scope.spawn(move || {
            let session = fixture
                .server()
                .accept(&listener, owner, Arc::new(AtomicBool::new(false)))
                .unwrap();
            accepted.send(()).unwrap();
            wait.recv_timeout(Duration::from_secs(5)).unwrap();
            drop(session);
        });
        let start = Instant::now();
        run(async {
            let mut call = Box::pin(transfer::upload_device_cycle(
                &mut a, &mut spool, &settings, "unused", &provider, [1; 16], epoch,
            ));
            tokio::select! {result=&mut call=>panic!("stalled reply completed: {result:?}"),_=tokio::time::sleep(Duration::from_millis(200))=>{}}
            drop(call);
        });
        assert!(ready.try_recv().is_ok());
        assert!(start.elapsed() < Duration::from_secs(1));
        done.send(()).unwrap();
        peer.join().unwrap();
    });
    assert_eq!(a.pending(epoch).unwrap().len(), 1);
}
