    fallback.set_nonblocking(true).unwrap();
    let settings = f.settings("alice@home.test", fallback.local_addr().unwrap());
    let mut spool = Spool::open(&f.root.join("spool")).unwrap();
    transfer::prepare(
        &mut a,
        &mut spool,
        [1; 16],
        selection(b"private", epoch),
        epoch,
    )
    .unwrap();
    let before = fs::read(f.root.join("spool/private-blobs.snapshot")).unwrap();
    for change in 0..3 {
        let mut expected = Fixture::principal(&a);
        match change {
            0 => expected.account = "other@home.test".into(),
            1 => expected.device += 1,
            _ => expected.identity[31] ^= 1,
        };
        let provider = DeviceProvider::new(
            Config::new(
                "home.test",
                listener.local_addr().unwrap(),
                "provider.test",
                f.digests[0],
                expected,
            )
            .unwrap(),
            f.credentials(1),
        );
        assert!(provider.validate(&a).is_err());
        assert!(
            run(transfer::upload_device_cycle(
                &mut a, &mut spool, &settings, "unused", &provider, [1; 16], epoch
            ))
            .is_err()
        );
        assert_eq!(
            fs::read(f.root.join("spool/private-blobs.snapshot")).unwrap(),
            before
        );
    }
    assert!(listener.accept().is_err());
    assert!(fallback.accept().is_err());
    assert_eq!(a.pending(epoch).unwrap().len(), 1);
}
