fn cancellation_during_stalled_handshake_runs_on_current_thread_and_joins_socket_worker() {
    let f = Fixture::new();
    let (mut a, _b, epoch) = f.pair(false);
    let mut spool = Spool::open(&f.root.join("outgoing")).unwrap();
    transfer::prepare(
        &mut a,
        &mut spool,
        [1; 16],
        selection(b"keep pending", epoch),
        epoch,
    )
    .unwrap();
    let settings = f.settings("alice@home.test", unused_endpoint());
    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
    let provider = f.provider(&a, 1, listener.local_addr().unwrap());
    thread::scope(|scope| {
        let peer = scope.spawn(move || {
            let (mut socket, _) = listener.accept().unwrap();
            socket
                .set_read_timeout(Some(Duration::from_secs(2)))
                .unwrap();
            let mut bytes = [0; 8192];
            while socket.read(&mut bytes).unwrap_or(0) != 0 {}
        });
        let start = Instant::now();
        run(async {
            let mut call = Box::pin(transfer::upload_device_cycle(
                &mut a, &mut spool, &settings, "unused", &provider, [1; 16], epoch,
            ));
            tokio::select! {result=&mut call=>panic!("stalled handshake completed: {result:?}"),_=tokio::time::sleep(Duration::from_millis(40))=>{}}
            drop(call);
        });
        assert!(start.elapsed() < Duration::from_secs(1));
        peer.join().unwrap();
    });
    assert_eq!(a.pending(epoch).unwrap().len(), 1);
}
