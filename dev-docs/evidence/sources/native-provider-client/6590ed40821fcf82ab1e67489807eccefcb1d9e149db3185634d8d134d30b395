fn current_vault_full_identity_is_checked_before_connection_or_spool_progress() {
    let f = Fixture::new();
    let (mut a, _b, epoch) = f.pair(false);
    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
    listener.set_nonblocking(true).unwrap();
