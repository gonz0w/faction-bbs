                tokio::net::TcpStream::connect(addr),
            )
            .await
            {
                Ok(Ok(socket)) => held.push(socket),
                Err(_) => {
                    stalled = true;
                    break;
                }
                other => panic!("loopback backlog setup: {other:?}"),
            }
        }
        assert!(
            stalled,
            "owned backlog did not produce pending TCP within four sockets"
        );
        let start = Instant::now();
        let mut call = Box::pin(transfer::upload_device_cycle(
            &mut a, &mut spool, &settings, "unused", &provider, [1; 16], epoch,
        ));
        tokio::select! {result=&mut call=>panic!("pending TCP completed: {result:?}"),_=tokio::time::sleep(Duration::from_millis(40))=>{}}
        drop(call);
        assert!(start.elapsed() < Duration::from_secs(1));
        drop(held);
    });
    drop(listener);
    assert_eq!(a.pending(epoch).unwrap().len(), 1);
}
#[test]
fn keylog_child() {
    if std::env::var_os("FACTION279_KEYLOG_TEST").is_none() {
        return;
    }
    let f = Fixture::new();
    let (a, _b, _) = f.pair(false);
    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
    listener.set_nonblocking(true).unwrap();
    let provider = f.provider(&a, 1, listener.local_addr().unwrap());
    assert!(matches!(
        provider.validate(&a),
        Err(faction_client::mail_device_provider::Error::Keylog)
    ));
    assert!(listener.accept().is_err());
}
#[test]
fn inherited_key_logging_is_refused_without_environment_mutation_or_connection() {
    for key in ["SSLKEYLOGFILE", "TLSKEYLOGFILE"] {
        for value in ["", "owned-do-not-open"] {
            let result = Command::new(std::env::current_exe().unwrap())
                .args(["--exact", "keylog_child"])
                .env_remove("SSLKEYLOGFILE")
                .env_remove("TLSKEYLOGFILE")
                .env("FACTION279_KEYLOG_TEST", "1")
                .env(key, value)
                .output()
                .unwrap();
            assert!(
                result.status.success(),
                "{}",
                String::from_utf8_lossy(&result.stdout)
            );
        }
    }
