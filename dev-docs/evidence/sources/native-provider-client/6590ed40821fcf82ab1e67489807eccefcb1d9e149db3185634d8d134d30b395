    fn serve<T>(
        &self,
        runtime: &Runtime,
        store: &mut faction_files::private_blobs::Store,
        action: impl FnOnce(SocketAddr) -> T,
    ) -> T {
        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
        let address = listener.local_addr().unwrap();
        thread::scope(|scope| {
            let server = scope.spawn(move || {
                let service = BinaryService::new("home.test").unwrap();
                if let Ok(mut session) =
                    self.server()
                        .accept(&listener, runtime, Arc::new(AtomicBool::new(false)))
                {
                    while matches!(session.serve_service_next(store, &service), Ok(true)) {}
                }
            });
            let result = action(address);
            let drain = Instant::now();
            server.join().unwrap();
            assert!(drain.elapsed() < Duration::from_secs(5));
