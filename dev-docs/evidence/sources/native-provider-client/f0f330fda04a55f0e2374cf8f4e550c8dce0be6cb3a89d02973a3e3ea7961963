//! Binary-local private provider profile; no remote entry or endpoint discovery.
#[cfg(test)]
mod tests {
    use super::*;
    use std::{fs, os::unix::fs::{DirBuilderExt, PermissionsExt, symlink}, path::PathBuf};
    struct Owned(PathBuf);
    impl Owned {
        fn new() -> Self {
            let mut id = [0; 16]; getrandom::fill(&mut id).unwrap();
            let root = std::env::temp_dir().canonicalize().unwrap().join(format!("faction280-profile-OWNED-{}", faction_client::mail_data::hex(&id)));
            fs::DirBuilder::new().mode(0o700).create(&root).unwrap();
            fs::write(root.join("OWNED"), b"owned profile tests").unwrap();
            Self(root)
        }
        fn file(&self) -> PathBuf {
            let path=self.0.join("credential");fs::write(&path,b"bounded secret").unwrap();
            fs::set_permissions(&path,fs::Permissions::from_mode(0o600)).unwrap();path
        }
    }
    impl Drop for Owned { fn drop(&mut self) { assert_eq!(fs::read(self.0.join("OWNED")).unwrap(),b"owned profile tests");fs::remove_dir_all(&self.0).unwrap(); } }
    #[test]
    fn private_reader_bounds_ownership_modes_links_and_root() {
        let f=Owned::new();let path=f.file();
        assert_eq!(private_file(&path,&f.0,32).unwrap().as_slice(),b"bounded secret");
        assert!(private_file(&path,&f.0,3).is_err());
        fs::set_permissions(&path,fs::Permissions::from_mode(0o644)).unwrap();
        assert!(private_file(&path,&f.0,32).is_err());
        fs::set_permissions(&path,fs::Permissions::from_mode(0o600)).unwrap();
        let link=f.0.join("link");symlink(&path,&link).unwrap();
        assert!(private_file(&link,&f.0,32).is_err());
        let hard=f.0.join("hard");fs::hard_link(&path,&hard).unwrap();
        assert!(private_file(&path,&f.0,32).is_err());fs::remove_file(hard).unwrap();
        assert!(private_file(&f.0,&f.0,32).is_err());
        assert!(private_file(&path,&f.0.join("unrelated"),32).is_err());
        fs::write(&path,b"").unwrap();assert!(private_file(&path,&f.0,32).is_err());
    }
    #[test]
    fn profile_loader_exists_and_refuses_missing_local_configuration() {
        let _loader = load;
    }
}
