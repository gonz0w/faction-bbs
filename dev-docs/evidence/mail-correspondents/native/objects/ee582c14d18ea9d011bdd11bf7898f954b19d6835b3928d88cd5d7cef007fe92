data=remote('/usr/pkg/bin/python3.13 -c '+shlex.quote(code)).stdout;archive=P/'native-main-captures.private.tar.gz';archive.write_bytes(data);archive.chmod(0o600)
out=P/'native-private';out.mkdir(mode=0o700)
with tarfile.open(fileobj=io.BytesIO(data),mode='r:gz') as t:
 for member in t:
