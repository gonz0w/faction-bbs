import tarfile,io
code='''from pathlib import Path
import tarfile,sys
p=Path('/home/factionbuild/device235')
with tarfile.open(fileobj=sys.stdout.buffer,mode='w|gz') as t:
 for f in sorted(p.glob('correspondents-menu-OWNED-*')):
