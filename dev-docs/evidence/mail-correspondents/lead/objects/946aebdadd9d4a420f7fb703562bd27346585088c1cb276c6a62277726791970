from pathlib import Path
import hashlib,json,os,subprocess,time
R=Path('/Users/cam/DEV/faction-bbs');P=Path('/private/tmp/faction235-lead-OWNED');O=P/'host-objects';O.mkdir(exist_ok=True)
def snapshot():
 names=subprocess.check_output(['git','ls-files','--cached','--others','--exclude-standard','Cargo.toml','Cargo.lock','crates','native'],cwd=R,text=True).splitlines();result={}
 for name in sorted(set(names)):
  path=R/name
  if not path.is_file() or path.is_symlink() or any(x in path.parts for x in ('target','__pycache__')):continue
  data=path.read_bytes();sha=hashlib.sha256(data).hexdigest();(O/sha).write_bytes(data);result[name]=sha
 return result
before=snapshot();(P/'host-before.json').write_text(json.dumps(before,indent=2,sort_keys=True)+'\n')
commands=[['cargo','fmt','--all','--','--check'],['cargo','clippy','--workspace','--all-targets','--release','--locked','--offline','-j','2','--','-D','warnings'],['cargo','test','--workspace','--release','--locked','--offline','-j','2','--','--test-threads=1']]
checks=[]
for index,cmd in enumerate(commands):
 start=time.monotonic()
 with (P/f'host-{index}.log').open('wb') as f:r=subprocess.run(cmd,cwd=R,stdout=f,stderr=subprocess.STDOUT)
 checks.append(dict(command=cmd,returncode=r.returncode,elapsed_seconds=time.monotonic()-start));print(json.dumps(checks[-1]),flush=True)
 if r.returncode:break
after=snapshot();(P/'host-after.json').write_text(json.dumps(after,indent=2,sort_keys=True)+'\n')
result=dict(result='pass' if len(checks)==3 and all(c['returncode']==0 for c in checks) and before==after else 'fail',source_stable=before==after,checks=checks)
(P/'host-result.json').write_text(json.dumps(result,indent=2)+'\n');assert result['result']=='pass'
