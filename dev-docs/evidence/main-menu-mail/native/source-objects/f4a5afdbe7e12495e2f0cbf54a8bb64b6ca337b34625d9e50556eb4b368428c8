[package]
name = "faction-client"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish.workspace = true

[features]
default = []
native-mail = ["dep:faction-omemo", "faction-omemo/native"]

network-mail = ["native-mail", "dep:faction-xmpp", "dep:tokio", "dep:roxmltree"]

[dependencies]
faction-xmpp = { path = "../faction-xmpp", optional = true }
tokio = { version = "=1.54.1", default-features = false, features = ["rt", "time", "net", "io-util", "macros"], optional = true }
roxmltree = { workspace = true, optional = true }
faction-omemo = { path = "../faction-omemo", optional = true, default-features = false }
faction-client-pty = { path = "../faction-client-pty" }
faction-files = { path = "../faction-files" }
faction-terminal = { path = "../faction-terminal" }
rustix.workspace = true
toml.workspace = true
base64.workspace = true
getrandom.workspace = true
sha2.workspace = true
argon2.workspace = true
zeroize.workspace = true
chacha20poly1305.workspace = true

[[example]]
name = "checkpoint_ui_fixture"
required-features = ["native-mail"]

[[example]]
name = "home_mail_fixture"
required-features = ["network-mail"]
