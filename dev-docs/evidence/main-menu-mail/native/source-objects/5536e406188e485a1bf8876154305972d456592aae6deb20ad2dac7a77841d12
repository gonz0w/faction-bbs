def source_context(name,root):
 manifest={}
 for f in sorted(root.rglob('*')):
  if not f.is_file() or f.is_symlink():continue
  rel=f.relative_to(root)
  if any(x in rel.parts for x in ['.git','target','__pycache__','.DS_Store']):continue
  if not(f.suffix in allowed or f.name.startswith('LICENSE') or f.name in {'SHA256SUMS','faction_broker','faction_sshd','faction_files_sshd','faction_doors'}):continue
  data=f.read_bytes();assert not data.startswith((b'\x7fELF',b'\x1f\x8b',b'QFI\xfb',b'PK\x03\x04')),str(f)
  h=hashlib.sha256(data).hexdigest();put('source-objects/'+h,data);manifest[str(rel)]=h
 put('source-maps/'+name+'.json',(json.dumps(manifest,sort_keys=True,indent=2)+'\n').encode())
