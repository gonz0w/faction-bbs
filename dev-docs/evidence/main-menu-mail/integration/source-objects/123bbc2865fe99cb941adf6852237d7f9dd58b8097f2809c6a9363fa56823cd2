for relative,digest in scan['files'].items():
 source=p/'late-files-private'/relative;raw=source.read_bytes();assert hashlib.sha256(raw).hexdigest()==digest
 part=Path(relative);target=out/('logs' if part.name.endswith('.log') else 'results')/part;target.parent.mkdir(parents=True,exist_ok=True)
 if target.exists():assert target.read_bytes()==raw
