 path=p/'host-files-final01'/name;raw=path.read_bytes();assert any(hashlib.sha256(raw).hexdigest()==h for h in scan['files'].values())
 dest=out/('logs' if name.endswith('.log') else 'results')/'host-files-final01'/name
 if dest.exists():assert dest.read_bytes()==raw
