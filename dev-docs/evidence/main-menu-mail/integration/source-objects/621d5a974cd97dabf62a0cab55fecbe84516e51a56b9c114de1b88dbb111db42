"""Scan late public executable sources against private inventory before exporting."""
from pathlib import Path
import hashlib,json,re
p=Path('/private/tmp/faction230-native-OWNED');own=Path('/private/tmp/faction230-integration-OWNED');out=p/'public'
values=json.loads((p/'generated-inventory.final.private.json').read_bytes())
for path in p.rglob('*.json'):
 if path.name not in {'private-markers.json','private-inputs.json'} and not(path.name.startswith('generated-') and path.name.endswith('.private.json')):continue
 data=json.loads(path.read_bytes())
 if isinstance(data,list):values.extend(v for v in data if isinstance(v,str))
 elif isinstance(data,dict):values.extend(data[k] for k in ['home_password','subject','body','password'] if k in data)
values.append((p/'sysop-password.private').read_text())
for name in ['member-key','lab-admin-key']:values.extend(v for v in (p/name).read_text().splitlines() if len(v)>=32 and not v.startswith('-----'))
public={'checkpoint synthetic fixture password','synthetic private archive id','synthetic-private-archive-id','synthetic subject','synthetic incoming','synthetic received body'}
needles={v.encode() for v in values if v and v not in public}
def safe(raw):
 assert not any(n in raw for n in needles),'private value; export refused'
 assert not re.search(rb'(?m)^-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----',raw),'key material; export refused'
def put(relative,raw):
 safe(raw);target=out/relative;target.parent.mkdir(parents=True,exist_ok=True)
 if target.exists():assert target.read_bytes()==raw
 else:target.write_bytes(raw)
def stage(label,files,base):
 mapped={}
 for path in files:
  raw=path.read_bytes();safe(raw);digest=hashlib.sha256(raw).hexdigest();put('source-objects/'+digest,raw);mapped[str(path.relative_to(base))]=digest
 put('source-maps/'+label+'.json',(json.dumps(mapped,indent=2,sort_keys=True)+'\n').encode())
stage('late-orchestration',sorted(p.glob('*.py')),p)
for label in ['privacy-oracle-before','privacy-oracle-red','privacy-oracle-green','native-files-final02']:
 base=p/label
 stage(label,sorted(base.rglob('*.py')),base)
for name in ['native-files-settings-owner-correction.json']:
 path=p/name
 if path.exists():put('provenance/'+name,path.read_bytes())
for label in ['privacy-oracle-red','privacy-oracle-green']:
 base=p/label
 for path in base.glob('*.log'):put('logs/'+label+'/'+path.name,path.read_bytes())
print('Late public source stages passed actual-private-value scan before export.')
