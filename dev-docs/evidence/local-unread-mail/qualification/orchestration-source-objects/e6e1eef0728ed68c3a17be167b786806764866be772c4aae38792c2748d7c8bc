"""Owned real-SSH Files controls when no local home-mail catalog is configured."""
import argparse,json,os,sys,tempfile,termios,platform,select,time
from pathlib import Path
p=argparse.ArgumentParser()
for name in ['default','native','network','settings','private-root','tools','output']:p.add_argument('--'+name,type=Path,required=True)
a=p.parse_args();sys.path.insert(0,str(a.tools))
from smoke_board_launcher import LauncherConsole,PICK,CONFIRM,RETURN
assert (a.private_root/'OWNED').is_file();assert a.settings.stat().st_mode&0o077==0
s=json.loads(a.settings.read_text());assert s['disposable_fixture'] is True
root=Path(tempfile.mkdtemp(prefix='off-files-',dir=a.private_root));root.chmod(0o700)
catalog=root/'boards.toml';catalog.write_text('version=1\n[[boards]]\nid="owned"\nlabel="Owned off-path board"\nprofile='+json.dumps(s['profile'])+'\n');catalog.chmod(0o600)
checks=[];children=[]
def absent(data):
 assert all(x not in data for x in [b'[E] Encrypted home mail',b'[N] Local mail notices',b'LOCAL checkpoint passphrase',b'LOCAL: open encrypted home mail',b'LOCAL MAIL',b'HOME account password'])
try:
 for label,binary in [('default',a.default),('native_only',a.native),('network_mail',a.network)]:
  c=LauncherConsole([binary,'--boards',catalog]);children.append(c);c.expect(PICK);c.raw(b'a');c.expect(CONFIRM);c.send('y')
  c.expect('[L]ogin [R]egister [Q]uit: ');c.send('l');c.expect('Handle: ');c.send('sysop');c.password(s['sysop_password']);c.expect('Press Enter to continue: ');c.send('');c.expect('Ctrl-C exits; Esc: Enter to recover.')
  c.raw(b'f');c.expect('Faction // Files on your device');c.expect('Back to the BBS');absent(c.transcript)
  c.raw(b'en');end=time.monotonic()+.2
  while time.monotonic()<end:
   if select.select([c.fd],[],[],.02)[0]:
    data=os.read(c.fd,8192);c.buffer+=data;c.transcript+=data
  absent(c.transcript)
  c.raw(b'a');c.expect('After area ID [0]: ');c.send('');c.expect('Enter to return to Files: ');c.send('');c.expect('Back to the BBS');absent(c.transcript)
  c.raw(b'b');c.expect('Ctrl-C exits; Esc: Enter to recover.');c.raw(b'q');c.expect('Logged out.');c.expect(RETURN);c.send('');c.expect(PICK);c.raw(b'q');c.finish();assert termios.tcgetattr(c.fd)[3]&termios.ECHO
  assert s['sysop_password'].encode() not in c.transcript;checks.append(label+'_unconfigured_files_no_mail_authority_rpc_and_restore')
 result=dict(result='pass',platform=platform.system(),count=len(checks),checks=checks,real_ssh=True,no_home_catalog=True,ignored_local_e_n=True,normal_areas_rpc=True,terminal_restored=True,physical_hardware=False,capacity_claim=False)
 a.output.write_text(json.dumps(result,indent=2)+'\n');print('Unconfigured real Files controls passed:',len(checks))
except BaseException:
 for i,c in enumerate(children):(root/('failure-'+str(i)+'.private')).write_bytes(c.transcript+c.buffer)
 raise
finally:
 for c in children:c.close()
