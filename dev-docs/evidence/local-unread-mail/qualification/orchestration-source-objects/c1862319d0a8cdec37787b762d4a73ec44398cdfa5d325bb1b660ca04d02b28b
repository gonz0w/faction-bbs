from lab import *
import signal,time
lines=subprocess.check_output(['ps','-axo','pid=,ppid=,comm=,args='],text=True).splitlines();matches=[]
for line in lines:
 fields=line.strip().split(None,3)
 if len(fields)==4 and fields[2] in {'/usr/bin/ssh','ssh'} and str(P/'member-key') in fields[3] and 'factionterm@127.0.0.1' in fields[3]:matches.append((int(fields[0]),fields[3]))
assert len(matches)==1
(P/'baseline-orphan-identity.private').write_text(json.dumps(matches))
pid,cmd=matches[0];actual=subprocess.check_output(['ps','-p',str(pid),'-o','args='],text=True).strip();assert actual==cmd
os.kill(pid,signal.SIGTERM)
for _ in range(20):
 check=subprocess.run(['ps','-p',str(pid),'-o','comm='],capture_output=True)
 if check.returncode:break
 time.sleep(.1)
else:raise AssertionError('Owned orphan did not stop')
print('Only matched owned baseline SSH orphan stopped; recordedPID/command retained privately.')
