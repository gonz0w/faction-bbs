//! Visit-local generic mail notices; never opens a vault or network connection.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub(super) struct Counts {
    pub unread: Option<usize>,
    pub retained: usize,
    pub pending: usize,
}
#[derive(Default)]
pub(super) struct VisitMail {
    configured: bool,
    notices: bool,
    snapshot: Option<Counts>,
}
impl VisitMail {
    pub fn new(configured: bool) -> Self { Self { configured, ..Self::default() } }
    pub fn configured(&self) -> bool { self.configured }
    pub fn toggle(&mut self) {
        if self.configured { self.notices = !self.notices; }
        self.snapshot = None;
    }
    pub fn record(&mut self, counts: Option<Counts>) {
        self.snapshot = if self.configured && self.notices { counts } else { None };
    }
    pub fn notice(&self) -> Option<String> {
        if !self.configured { return None; }
        Some(if !self.notices {
            "LOCAL MAIL: N notices off; E opens home mail.\r\n".into()
        } else if let Some(counts)=self.snapshot {
            let status=counts.unread.map_or_else(|| "tracking disabled; unread unknown".into(), |n| format!("unread: {n}"));
            format!("LOCAL MAIL / LOCKED / stale local snapshot\r\n{status}; retained: {}; pending: {}\r\nNot a home inbox total. N turns notices off.\r\n", counts.retained,counts.pending)
        } else {
            "LOCAL MAIL / LOCKED: unread unknown.\r\nNotices on; E unlocks manually. N turns off.\r\n".into()
        })
    }
}
#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn only_configured_visits_offer_mail_and_notices() {
        assert!(!VisitMail::default().configured());
        assert!(VisitMail::default().notice().is_none());
        let visit = VisitMail::new(true);
        assert!(visit.configured());
        assert!(visit.notice().unwrap().contains("notices off"));
    }
    #[test]
    fn explicit_opt_in_retains_only_stale_local_counts_and_opt_out_clears() {
        let mut visit = VisitMail::new(true);
        let counts=Counts {unread:Some(2),retained:4,pending:1};
        visit.record(Some(counts));
        assert!(!visit.notice().unwrap().contains("unread: 2"));
        visit.toggle();
        assert!(visit.notice().unwrap().contains("unread unknown"));
        visit.record(Some(counts));
        let notice=visit.notice().unwrap();
        for text in ["LOCKED", "unread: 2", "stale", "retained: 4", "pending: 1"] {assert!(notice.contains(text), "{notice}");}
        visit.toggle(); visit.toggle();
        assert!(visit.notice().unwrap().contains("unread unknown"));
    }
    #[test]
    fn error_or_disabled_tracking_never_claims_a_fresh_inbox_count() {
        let mut visit=VisitMail::new(true); visit.toggle();
        visit.record(Some(Counts {unread:None,retained:2,pending:1}));
        assert!(visit.notice().unwrap().contains("tracking disabled"));
        visit.record(None);
        assert!(visit.notice().unwrap().contains("unread unknown"));
        let mut off=VisitMail::default();off.toggle();off.record(Some(Counts{unread:Some(99),retained:99,pending:9}));
        assert!(off.notice().is_none());
    }
}
