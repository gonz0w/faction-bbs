"""Publish only hash-verified public source snapshots, never runtime fixture data."""
from pathlib import Path, PurePosixPath
import hashlib,json,re,sys
REPO=Path('/Users/cam/DEV/faction-bbs')
OWNED=Path('/private/tmp/faction219-lead-OWNED')
BASE=REPO/'dev-docs/evidence/mail-inbox'
OBJECTS=BASE/'source-objects'
CATALOGUE=OWNED/'publication-source-stages.json'

def digest(raw):return hashlib.sha256(raw).hexdigest()
def relative(name):
 path=PurePosixPath(name)
 assert name and not path.is_absolute() and '..' not in path.parts and str(path)==name and '\\' not in name

def object_index():
 index={}
 for path in (REPO/'dev-docs/evidence').rglob('*'):
  if re.fullmatch('[a-f0-9]{64}',path.name) and path.is_file() and not path.is_symlink():
   index.setdefault(path.name,path)
 return index

def preserve(raw,index):
 sha=digest(raw);path=index.get(sha,OBJECTS/sha)
 if path.exists():assert digest(path.read_bytes())==sha
 else:
  path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(raw);index[sha]=path
 return dict(path=str(path.relative_to(REPO)),sha256=sha)

def publish(label,tree,manifest):
 data=json.loads(manifest.read_bytes());assert data
 stages=json.loads(CATALOGUE.read_bytes()) if CATALOGUE.exists() else []
 assert all(stage['label']!=label for stage in stages)
 index=object_index();rows=[]
 for name,expected in data.items():
  relative(name);assert re.fullmatch('[a-f0-9]{64}',expected)
  path=tree/name;assert path.is_file() and not path.is_symlink()
  raw=path.read_bytes();assert digest(raw)==expected,name
  rows.append(dict(name=name,**preserve(raw,index)))
 stages.append(dict(label=label,files=rows))
 CATALOGUE.write_text(json.dumps(stages,indent=2)+'\n')
 print(label+': '+str(len(rows))+' exact source bindings preserved.')

if __name__=='__main__':
 assert len(sys.argv)==4
 publish(sys.argv[1],Path(sys.argv[2]),Path(sys.argv[3]))
