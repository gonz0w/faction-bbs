from pathlib import Path
import hashlib,json,os,shutil,tarfile

P=Path('/private/tmp/faction219-native-OWNED')
old=P/'source-client-candidate02'
dest=P/'source-client-candidate03-qualified'
manifest=json.loads((P/'source-client-candidate02.json').read_text())
name='crates/faction-client/src/checkpoint_ui.rs'
replacement=(P/'source-client-candidate03'/name).read_bytes()
assert hashlib.sha256(replacement).hexdigest()=='669dea471a4707ee3b999b3bad38e309ee4324572864fa610f25ffc257e1454e'
assert replacement.split(b'#[cfg(test)]')[0]==(old/name).read_bytes().split(b'#[cfg(test)]')[0]
