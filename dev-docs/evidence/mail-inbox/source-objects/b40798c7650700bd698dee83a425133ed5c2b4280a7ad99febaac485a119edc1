os.umask(0o077)
dest.mkdir(mode=0o700)
for filename,digest in manifest.items():
 data=(old/filename).read_bytes()
 assert hashlib.sha256(data).hexdigest()==digest
 if filename==name:data=replacement
 target=dest/filename;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(data)
