 for filename in sorted(actual):archive.add(dest/filename,arcname=filename,recursive=False)
(P/'candidate03-qualified-origin.json').write_text(json.dumps({'result':'pass','base_source_map':'source-client-candidate02.json','override':{name:actual[name]},'source_files':len(actual),'non_test_ui_prefix_identical':True,'unexecuted_worktree_snapshot_preserved':'source-client-candidate03.json','excluded_unexecuted_guard_change':'tools/test_picker_evidence_bytes.py'},indent=2)+'\n')
