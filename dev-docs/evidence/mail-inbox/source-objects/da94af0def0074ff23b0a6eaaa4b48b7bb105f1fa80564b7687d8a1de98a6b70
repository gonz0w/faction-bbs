from pathlib import Path
import os,subprocess,json,hashlib,shutil,time

proof=Path('/home/factionbuild/proof219')
root=Path('/home/factionbuild/source219-client')
target=Path('/home/factionbuild/target219')
env=os.environ.copy()
env.update(CARGO_HOME='/home/factionbuild/cargo219',CARGO_TARGET_DIR=str(target),CARGO_BUILD_JOBS='1',OPENSSL_INCLUDE_DIR='/usr/include',OPENSSL_LIB_DIR='/usr/lib',PYTHONDONTWRITEBYTECODE='1')
result={'result':'running','scope':'two-core-2GiB-compile-and-focused-tests','stages':[]}
base=['cargo','build','--release','--locked','--offline','-j','1','-p','faction-client','--bin','faction-client']
steps=[
 ('default',base,'faction-client-default'),
 ('native',base+['--features','native-mail'],'faction-client-native'),
 ('network',base+['--features','network-mail'],'faction-client-network'),
 ('fixtures',['cargo','build','--release','--locked','--offline','-j','1','-p','faction-client','--features','network-mail','--example','checkpoint_ui_fixture','--example','home_mail_fixture'],None),
 ('native-tests',['cargo','test','--release','--locked','--offline','-j','1','-p','faction-client','--features','native-mail','--all-targets','--','--test-threads=1'],None),
 ('network-tests',['cargo','test','--release','--locked','--offline','-j','1','-p','faction-client','--features','network-mail','--all-targets','--','--test-threads=1'],None),
 ('clippy',['cargo','clippy','--release','--locked','--offline','-j','1','-p','faction-client','--features','network-mail','--all-targets','--','-D','warnings'],None),
]
for name,command,copy in steps:
 started=time.monotonic()
 with (proof/('client-'+name+'.private.log')).open('wb') as log:
  completed=subprocess.run(command,cwd=root,env=env,stdout=log,stderr=log)
 result['stages'].append({'name':name,'command':command,'returncode':completed.returncode,'elapsed_seconds':round(time.monotonic()-started,3)})
 if completed.returncode:
  result['result']='fail';(proof/'client-build.json').write_text(json.dumps(result,indent=2)+'\n');raise SystemExit(1)
 if copy:
  shutil.copyfile(target/'release/faction-client',target/'release'/copy);(target/'release'/copy).chmod(0o755)
 (proof/'client-build.json').write_text(json.dumps(result,indent=2)+'\n')
result['result']='pass'
result['artifacts_sha256']={name:hashlib.sha256((target/'release'/name).read_bytes()).hexdigest() for name in ['faction-client-default','faction-client-native','faction-client-network','examples/checkpoint_ui_fixture','examples/home_mail_fixture']}
(proof/'client-build.json').write_text(json.dumps(result,indent=2)+'\n')
