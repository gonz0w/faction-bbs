def read(path):return json.loads(path.read_bytes())
def summaries(path):
 result=[];current=None;last=None
 for line in path.read_text().splitlines():
  if 'Running ' in line and ('unittests ' in line or ' tests/' in line or ' examples/' in line):
   if current is not None and last is not None:result.append(dict(harness=current,**last))
   current=line.strip();last=None
  match=re.search(r'test result: (ok|FAILED)\. (\d+) passed; (\d+) failed; (\d+) ignored',line)
  if match:last=dict(result=match[1],passed=int(match[2]),failed=int(match[3]),ignored=int(match[4]))
 if current is not None and last is not None:result.append(dict(harness=current,**last))
 assert result and all(row['result']=='ok' and row['failed']==0 for row in result)
 # Harness paths are not authority; retain labels/counts without private paths.
 return [dict(index=index,passed=row['passed'],failed=row['failed'],ignored=row['ignored']) for index,row in enumerate(result)]
