class Evidence(unittest.TestCase):
 def save(self,value):
  self.serial+=1;data=value if isinstance(value,bytes) else (json.dumps(value)+'\n').encode()
  path=f'{self.serial}.raw';(self.root/path).write_bytes(data)
  return dict(path=path,sha256=hashlib.sha256(data).hexdigest())
 def read(self,ref):return json.loads((self.root/ref['path']).read_bytes())
