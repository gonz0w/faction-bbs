  temp=tempfile.TemporaryDirectory();self.addCleanup(temp.cleanup);self.root=Path(temp.name);self.serial=0
  self.source=self.save(b'executed source\r\n');files={name:self.source['sha256'] for name in PRODUCTION}
  self.record=dict(schema=1,issue=239,result='pass',profile=dict(normal_sessions=8,launch_ms=5000,credential_permits=2,kernel_slots=2,owner_helpers=3,drain_seconds=5,parked_prompt_seconds=120,nonce_budget=64),claims={k:False for k in ('background_polling','credential_lease','automatic_read_ack','schema_change','new_dependency','new_crypto','remote_notices','physical_hardware','capacity','production_deployment')},sources=[self.source],prior_records=[self.save(b'prior evidence')],production=files,source_stages=[dict(label=label,manifest=self.save(files)) for label in ('host-final','native-final')],routes=dict(main={},shared={}),records={})
  associations={}
  for kind,keys in [('main',('host_classic','host_unicode','netbsd_classic','netbsd_unicode')),('shared',('host','netbsd'))]:
   associations[kind]={}
   for key in keys:
    controls=MAIN if kind=='main' else SHARED
    data=dict(result='pass',platform='Darwin' if key.startswith('host') else 'NetBSD',scope='same-ssh-main-menu-mail-notices' if kind=='main' else 'same-ssh-shared-main-files-mail-notices',unicode=key.endswith('_unicode'),count=len(controls),checks=sorted(controls),source_sha256=self.source['sha256'],capture_id=f'{self.serial:032x}',marker_count=10,private_matches=0,files_disabled=kind=='main',actual_home_transport_error='Connect',same_ssh_pid_until_normal_close=True,automatic_redial_observed=False,private_input_hashes=dict(trace_sha256='1'*64,marker_set_sha256='2'*64,file_scan_input_sha256='3'*64),board_io_reconstruction=dict(records=10,streams=3,decoded_bytes=100,read_bytes=20,write_bytes=80),privacy_scan=dict(matches=0,symlinks=0,board_files=4,store_files=1,log_files=2),notice_toggle_local_only=True,canonical_state_unchanged=True,consent_off_on_reenable_unknown=True,new_visit_notices_off=True,safe_back_default_after_redraw=True,locked_return_same_ssh=True,notice_cells_max=39,main_open_hint='O')
    if kind=='shared':data['files_open_hint']='E'
    ref=self.save(data);self.record['routes'][kind][key]=ref
    associations[kind][key]=dict(capture_id=data['capture_id'],source_sha256=data['source_sha256'],result_sha256=ref['sha256'],private_input_hashes=data['private_input_hashes'],generated_before_capture=True,input_trace_unchanged=True)
  records=dict(associations=dict(result='pass',routes=associations),native=dict(result='pass',files=files,source_count=len(files),all_source_match=True,compile_memory_mib=2048,runtime_physmem=1054990336),cleanup=dict(result='pass',owned_removed=True,saved_stopped=True,saved_hashes_unchanged=True,saved_sizes_mtimes_unchanged=True,forwards_closed=True),tdd=dict(result='pass',captured_before_edit=True,red_exit=101,green_exit=0),publication=dict(result='pass',generated_private_values_scanned=12,private_matches=0,raw_private_key_or_vault_matches=0,explicit_manifests_verified=True),rust=dict(result='pass',runs={k:dict(passed=5,ignored=0,log=self.save(b'test result: ok. 5 passed; 0 failed; 0 ignored;\n')) for k in ('workspace','network','native','netbsd')}))
  for name,data in records.items():self.record['records'][name]=self.save(data)
 def change_record(self,name,change):
  data=self.read(self.record['records'][name]);change(data);self.record['records'][name]=self.save(data)
 def change_route(self,kind,key,change):
  data=self.read(self.record['routes'][kind][key]);change(data);ref=self.save(data);self.record['routes'][kind][key]=ref
  # Coherently rebind every association field: stale hashes must not mask a missing semantic check.
  self.change_record('associations',lambda a:a['routes'][kind][key].update(result_sha256=ref['sha256'],capture_id=data['capture_id'],source_sha256=data['source_sha256'],private_input_hashes=data['private_input_hashes']))
 def reject(self):
  with self.assertRaises(AssertionError):self.guard.validate(self.root,self.record)
 def test_complete_matrix(self):self.guard.validate(self.root,self.record)
 def test_route_semantics_with_coherent_associations(self):
