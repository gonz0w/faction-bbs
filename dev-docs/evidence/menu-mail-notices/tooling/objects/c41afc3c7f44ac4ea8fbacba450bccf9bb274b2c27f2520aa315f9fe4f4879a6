  changes=[('scope','other'),('checks',sorted(MAIN)[:-1]),('count',99),('actual_home_transport_error','Config'),('files_disabled',False),('notice_toggle_local_only',False),('canonical_state_unchanged',False),('consent_off_on_reenable_unknown',False),('new_visit_notices_off',False),('safe_back_default_after_redraw',False),('locked_return_same_ssh',False),('main_open_hint','E'),('notice_cells_max',40),('private_matches',1),('marker_count',0),('same_ssh_pid_until_normal_close',False),('automatic_redial_observed',True),('capture_id','bad'),('source_sha256','f'*64),('private_input_hashes',dict(trace_sha256='1'*64))]
  for field,value in changes:
   with self.subTest(field=field):
    self.record=copy.deepcopy(original);self.change_route('main','host_classic',lambda d:d.update({field:value}));self.reject()
  self.record=copy.deepcopy(original);self.change_route('shared','host',lambda d:d.update(files_open_hint='O'));self.reject()
 def test_positive_io_and_privacy_scan(self):
  original=copy.deepcopy(self.record)
  for group,field,value in [('privacy_scan','matches',1),('privacy_scan','board_files',0),('privacy_scan','symlinks',1),('board_io_reconstruction','streams',0),('board_io_reconstruction','write_bytes',0),('board_io_reconstruction','decoded_bytes',101)]:
   with self.subTest(field=field):
    self.record=copy.deepcopy(original);self.change_route('main','host_classic',lambda d:d[group].update({field:value}));self.reject()
