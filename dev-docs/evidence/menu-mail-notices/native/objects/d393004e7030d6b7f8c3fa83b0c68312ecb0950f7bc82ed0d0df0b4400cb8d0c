def notice_lines(state, context, counts=None):
    assert context in {'main', 'files'} and state in {'off', 'unknown', 'stale'}
    key = 'O' if context == 'main' else 'E'
    if state == 'off':
        assert counts is None
        return [f'LOCAL MAIL: notices off. {key} opens mail.']
    if state == 'unknown':
        assert counts is None
        return ['LOCAL MAIL / LOCKED: unread unknown.', f'Notices on; {key} unlocks manually.', 'N turns notices off.']
    assert isinstance(counts, tuple) and len(counts) == 3
    unread, retained, pending = counts
    assert type(retained) is int and 0 <= retained <= 64
    assert type(pending) is int and 0 <= pending <= 8
    assert unread is None or type(unread) is int and 0 <= unread <= retained
    return ['LOCAL MAIL / LOCKED', 'stale local snapshot; home not polled.',
            'tracking disabled; unread unknown' if unread is None else f'unread: {unread}',
            f'retained: {retained}; pending: {pending}', f'{key} opens mail; N turns notices off.']


def require_notice(screen, state, context, counts=None):
    expected = notice_lines(state, context, counts)
    assert all(len(line) <= 39 for line in expected)
    assert screen == ('\r\n'.join(expected) + '\r\n').encode(), 'notice contains wrong context/counts, metadata or terminal controls'


def require_choice(screen):
    text = re.sub(rb'\x1b\[[0-9;?]*[ -/]*[@-~]', b'', screen)
    choices = re.findall(rb'(?m)^([> ]) \[([A-Z])\] ([^\r\n]*)\r?$', text)
    assert choices == [(b' ', b'O', b'Open encrypted home mail'), (b'>', b'B', b'Back to the BBS'), (b' ', b'N', b'Local notices')], 'choice set or safe Back default differs'


def require_mail_cycles(data, parks, direct_backs):
    assert type(parks) is int and parks >= 0 and type(direct_backs) is int and direct_backs >= 0
    rows = data.splitlines(keepends=True)
    active, consumed = None, set()
    observed_parks = observed_backs = 0
    for row in rows:
        match = re.fullmatch(rb'@MAIL1 (park|back) ([0-9a-f]{32})\r?\n', row)
        assert match, 'unexpected board input during local choice/console'
        action, nonce = match.groups()
        if action == b'park':
            assert active is None and nonce not in consumed, 'replayed nonce or nested park'
            consumed.add(nonce); active = nonce; observed_parks += 1
        else:
            if active is None:
                assert nonce not in consumed, 'replayed direct return nonce'
                consumed.add(nonce)
            else:
                assert active == nonce, 'return nonce changed'
                active = None
            observed_backs += 1
    assert active is None and observed_parks == parks and observed_backs == parks + direct_backs
    assert len(consumed) == parks + direct_backs
    return dict(parks=observed_parks, backs=observed_backs, nonces=len(consumed))


def require_local_toggle(before, after, board_input, screen):
    assert before == after, 'notice toggle changed canonical mail state'
    assert board_input == b'', 'notice toggle emitted board input'
    assert UNLOCK.encode() not in screen and HOME.encode() not in screen, 'notice toggle opened credentials'


def require_capture_association(inputs, trace, result):
    assert inputs['generated_before_capture'] is True
    for field in ['capture_id', 'source_sha256']:
        assert inputs[field] == trace[field] == result[field], 'capture or executed source association differs'
    assert inputs['marker_set_sha256'] == trace['marker_set_sha256'] == trace['marker_file_sha256_at_trace_start'] == result['private_input_hashes']['marker_set_sha256'], 'marker set changed across capture'
    assert inputs['file_scan_input_sha256'] == trace['scan_input_sha256_at_trace_start'] == result['private_input_hashes']['file_scan_input_sha256'], 'scan request changed across capture'
    assert re.fullmatch('[0-9a-f]{32}', inputs['capture_id'])
    assert all(re.fullmatch('[0-9a-f]{64}', value) for value in result['private_input_hashes'].values())


def private_write(path, data):
    path.write_bytes(data if isinstance(data, bytes) else data.encode())
    path.chmod(0o600)
    return path


SHARED_CHECKS = [
    'main_to_files_shares_consent_and_stale_snapshot',
    'files_to_main_opt_out_clears_snapshot_and_on_is_unknown',
    'corrected_GIO_and_board_files_private_markers_absent',
]


def probe_main_menu(a):
    import shlex
    import termios
    from probe_menu_mail import (TRACE_START, TRACE_STOP, TITLE, OPEN, BACK, CONFIRM_MAIL,
        MENU as BOARD_MENU, require_board_bound_private_absent, reconstruct_kdump_streams)
    from probe_visit_mail import (private_json, require_closed_endpoint, require_connection_refused,
        visit_processes, assert_same_visit, drain_ready, SCAN, validate_scan)
    from check_restricted_ssh import SSHConsole
    from smoke_board_launcher import LauncherConsole, PICK, CONFIRM, RETURN
    private_root(a.owned_root)
    settings = private_json(a.settings)
    assert settings['disposable_fixture'] is True
    assert settings['files_disabled'] is not a.shared_files
    root = Path(tempfile.mkdtemp(prefix='menu-notices-OWNED-', dir=a.owned_root)); root.chmod(0o700)
    children, trace, visit = [], None, None
    subject, body = 'subject-' + secrets.token_hex(12), 'body-' + secrets.token_hex(16)
    peer, other = 'peer-' + secrets.token_hex(8) + '@away.test', 'other-' + secrets.token_hex(8) + '@away.test'
    password, home_password = secrets.token_hex(24), secrets.token_hex(24)
    markers = [subject, body, peer, other, PASS, home_password, 'alice@home.test',
        'LOCAL MAIL / LOCKED', 'LOCAL MAIL: notices off.', 'unread: 3', 'retained: 8; pending: 1']
    source_hash = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    capture_id = a.capture_id
    assert re.fullmatch('[0-9a-f]{32}', capture_id), 'capture ID must be fixed by the runner before measurement'
    parks = direct_backs = 0
    def save(name, data): return private_write(root / name, data)
    def remote(code, data=None):
        r = subprocess.run(settings['admin_argv'] + ['/usr/pkg/bin/python3.13 -c ' + shlex.quote(code)], input=data, capture_output=True, timeout=45)
        if r.returncode: save('admin-failure.private', r.stdout + r.stderr)
        assert r.returncode == 0, 'owned board operation failed; private diagnostic retained'
        return r.stdout
    def fixture(action, store, mode=None):
        r = subprocess.run([str(a.fixture), action, str(store)] + ([mode] if mode else []), input=('\n'.join([subject, body, peer, other]) + '\n').encode() if action == 'seed' else b'', capture_output=True, timeout=90)
        if r.returncode: save('fixture-failure.private', r.stdout + r.stderr)
        assert r.returncode == 0
        return json.loads(r.stdout) if action == 'inspect' else None
    def state(store): return dict(canonical=(store / 'mail.fkv').read_bytes(), inspection=fixture('inspect', store))
    def login(c, handle, secret, register=False):
        c.expect('[L]ogin [R]egister [Q]uit: '); c.send('r' if register else 'l'); c.expect('Handle: '); c.send(handle); c.password(secret)
        if register: c.password(secret, 'Confirm password (hidden): ')
        else: c.expect('Press Enter to continue: '); c.send(''); c.expect(BOARD_MENU)
    def board():
        c = SSHConsole(settings['member_argv']); children.append(c); return c
    def same(): assert_same_visit(visit, visit_processes(c.pid))
    def menu(): c.expect(BOARD_MENU); same()
    def notice_screen(state_name, counts=None, context='main', start=None, safe=True):
        if start is None: start = len(c.transcript) - len(c.buffer)
        lines = notice_lines(state_name, context, counts)
        for line in lines: c.expect(line)
        drain_ready(c, .03)
        screen = c.transcript[start:]
        # Strip only ANSI screen-control sequences; notice bytes themselves stay exact.
        text = re.sub(rb'\x1b\[[0-9;?]*[ -/]*[@-~]', b'', screen)
        pos = text.index(b'LOCAL MAIL')
        notice = text[pos:]
        if notice.endswith(b'\r\r\n'): notice = notice.replace(b'\r\r\n', b'\r\n')
        require_notice(notice, state_name, context, counts)
        if context == 'main' and safe: require_choice(screen)
        return screen
    def choice(state_name, counts=None):
        start = len(c.transcript); c.raw(b'm'); c.expect(TITLE)
        return notice_screen(state_name, counts, start=start)
    def toggle(state_name, counts=None, context='main', check_state=True):
        prior_state = state(store) if check_state else None; start = len(c.transcript); c.raw(b'n')
        screen = notice_screen(state_name, counts, context=context, start=start)
        assert not check_state or prior_state == state(store), 'notice toggle changed encrypted canonical state'
        assert UNLOCK.encode() not in screen and HOME.encode() not in screen
        same(); return screen
    def back():
        nonlocal direct_backs
        c.raw(b'\r'); menu(); direct_backs += 1
    def open_mail():
        nonlocal parks
        c.raw(b'o'); c.expect(CONFIRM_MAIL); c.send('y'); c.expect(UNLOCK)
        assert not termios.tcgetattr(c.fd)[3] & termios.ECHO
        parks += 1
    def lock(): c.raw(b'l'); menu()
    def logout():
        c.raw(b'q'); c.expect('Logged out.'); c.expect(RETURN); c.send(''); c.expect(PICK)
    def connect():
        nonlocal visit
        c.raw(b'a'); c.expect(CONFIRM); c.send('y'); login(c, handle, password); visit = visit_processes(c.pid)
    def launch(catalog):
        child = LauncherConsole([str(a.client), '--boards', str(catalog)] + (['--unicode'] if a.unicode else [])); children.append(child); child.expect(PICK); return child
    try:
        stores = {}
        for mode in ['ready', 'unknown']:
            path = root / ('mail-' + mode); fixture('seed', path, mode); snapshot = state(path)
            stores[mode] = (path, snapshot)
            save(mode + '-canonical-before.private.json', json.dumps(snapshot['inspection']))
            for row in snapshot['inspection']['history']: markers.extend([row['identity'], row['subject'], row['body'], row['address']])
        markers = list(dict.fromkeys(markers)); marker_file = save('private-markers.json', json.dumps(markers))
        marker_hash = hashlib.sha256(marker_file.read_bytes()).hexdigest()
        scan_input = json.dumps(dict(markers=markers, board=settings['scan_board'], store=settings['scan_store'], log=settings['scan_logs'])).encode()
        scan_file = save('board-file-scan-input.private.json', scan_input)
        input_association = dict(capture_id=capture_id, source_sha256=source_hash, marker_set_sha256=marker_hash, generated_before_capture=True, file_scan_input_sha256=hashlib.sha256(scan_input).hexdigest())
        save('private-input-association.json', json.dumps(input_association))
        with socket.socket() as unused: unused.bind(('127.0.0.1', 0)); endpoint = unused.getsockname()
        require_closed_endpoint(endpoint)
        ca = save('public-ca.pem', a.public_ca.read_bytes())
        config = save('home.toml', 'version=1\naccount="alice@home.test"\nendpoint=' + json.dumps('127.0.0.1:' + str(endpoint[1])) + '\ndomain="home.test"\nca=' + json.dumps(str(ca)) + '\npin="' + 'ab' * 32 + '"\n')
        catalogs = {}
        for mode, (path, _) in stores.items():
            catalogs[mode] = save(mode + '-boards.toml', 'version=1\nhome_mail={store=' + json.dumps(str(path)) + ',config=' + json.dumps(str(config)) + '}\n[[boards]]\nid="approved"\nlabel="Owned notice board"\nprofile=' + json.dumps(settings['profile']) + '\n')
        store, before = stores['ready']
        outage = subprocess.run([str(a.mail_fixture), 'sync', str(store), str(config)], input=(PASS + '\n' + home_password + '\n').encode(), capture_output=True, timeout=30)
        require_connection_refused(outage.returncode, outage.stdout, outage.stderr); assert state(store) == before
        handle = settings['member_handle'] + secrets.token_hex(3)
        registration = board(); login(registration, handle, password, True); registration.expect('Registration pending; sysop approval required.'); registration.finish()
        sysop = board(); login(sysop, 'sysop', settings['sysop_password']); sysop.raw(b's'); sysop.expect('[C]reate room: '); sysop.send('a'); sysop.expect('Member handle: '); sysop.send(handle); sysop.expect('Status updated; previous sessions expired.'); sysop.expect('Press Enter to return to menu: '); sysop.send(''); sysop.expect(BOARD_MENU); sysop.raw(b'q'); sysop.expect('Logged out.'); sysop.finish()
        c = launch(catalogs['ready']); connect()
        trace = json.loads(remote(TRACE_START.replace('issue230-board-', 'issue239-board-')))
        trace_association = dict(trace=trace, capture_id=capture_id, source_sha256=source_hash, marker_set_sha256=marker_hash, marker_file_sha256_at_trace_start=hashlib.sha256(marker_file.read_bytes()).hexdigest(), scan_input_sha256_at_trace_start=hashlib.sha256(scan_file.read_bytes()).hexdigest())
        save('trace-input-association.private.json', json.dumps(trace_association))
        choice('off'); back()
        choice('off'); toggle('unknown'); back()
        choice('unknown'); open_mail(); c.send(PASS); c.expect(MENU); lock(); assert state(store) == before
        choice('stale', (3, 8, 1))
        if a.shared_files:
            back(); c.raw(b'f'); c.expect('Faction // Files on your device'); notice_screen('stale', (3, 8, 1), context='files')
            toggle('off', context='files'); c.raw(b'b'); menu()
            choice('off'); toggle('unknown'); back()
            c.raw(b'f'); c.expect('Faction // Files on your device'); notice_screen('unknown', context='files')
            c.raw(b'b'); menu(); choice('unknown'); back()
        else:
            toggle('off'); toggle('unknown'); back()
            choice('unknown'); open_mail(); c.send('wrong synthetic passphrase'); c.expect('Enter to return to the board: '); c.send(''); menu()
            choice('unknown'); open_mail(); c.raw(b'\x03'); menu()
            choice('unknown'); start = len(c.transcript); c.raw(b'oy\n'); c.expect(CONFIRM_MAIL); drain_ready(c)
            assert UNLOCK.encode() not in c.transcript[start:]; c.send('n'); menu(); direct_backs += 1
            # Seventy redraws in one offer exceed the whole visit's nonce budget
            # if N wrongly performs exchanges. All must remain local and usable.
            choice('unknown')
            for i in range(70): toggle('off' if i % 2 == 0 else 'unknown', check_state=False)
            back()
            choice('unknown'); open_mail(); c.send(PASS); c.expect(MENU)
            c.raw(b'n'); c.password(home_password, HOME); c.expect('Home cycle stopped; pending ciphertext retained.'); c.expect('Enter to return: '); c.send(''); c.expect(MENU); lock()
            choice('stale', (3, 8, 1)); back()
        assert state(store) == before; logout(); connect(); choice('off'); back(); logout(); c.raw(b'q'); c.finish()
        if not a.shared_files:
            store, before = stores['unknown']; c = launch(catalogs['unknown']); connect()
            choice('off'); toggle('unknown'); open_mail(); c.send(PASS); c.expect(MENU); lock()
            choice('stale', (None, 8, 1)); toggle('off'); toggle('unknown'); back()
            assert state(store) == before; logout(); c.raw(b'q'); c.finish()
        for mode, (path, initial) in stores.items():
            assert state(path) == initial
            save(mode + '-canonical-after.private.json', json.dumps(state(path)['inspection']))
            assert all(marker.encode() not in (path / 'mail.fkv').read_bytes() for marker in markers)
        scan = validate_scan(json.loads(remote(SCAN, scan_input)))
        board_io = remote(TRACE_STOP.replace('issue230-board-', 'issue239-board-'), json.dumps(trace).encode()); trace = None; save('board-io.private.log', board_io)
        reconstruction = require_board_bound_private_absent(board_io, [m.encode() for m in markers]); streams, _ = reconstruct_kdump_streams(board_io)
        requests = []
        for key, value in streams.items():
            if key[2] == 'read': requests.extend(re.findall(rb'@MAIL1 [^\r\n]*\r?\n', value))
        file_protocol_matches = sum(b'FACTION1;' in value or b'@FACTION1' in value for value in streams.values())
        protocol = require_mail_cycles(b''.join(requests), parks, direct_backs)
        if not a.shared_files: assert all(b'FACTION1;' not in value and b'@FACTION1' not in value for value in streams.values())
        require_closed_endpoint(endpoint)
        hashes = dict(trace_sha256=hashlib.sha256(board_io).hexdigest(), marker_set_sha256=marker_hash, file_scan_input_sha256=hashlib.sha256(scan_input).hexdigest())
        checks = SHARED_CHECKS if a.shared_files else MAIN_CHECKS
        result = dict(result='pass', platform=platform.system(), machine=platform.machine(), scope='same-ssh-shared-main-files-mail-notices' if a.shared_files else 'same-ssh-main-menu-mail-notices', unicode=a.unicode, count=len(checks), checks=checks, capture_id=capture_id, source_sha256=source_hash, marker_count=len(markers), private_input_hashes=hashes, privacy_scan=scan, board_io_reconstruction=reconstruction, private_matches=scan['matches'], files_disabled=not a.shared_files, actual_home_transport_error='Connect', same_ssh_pid_until_normal_close=True, automatic_redial_observed=False, private_fixture_retained_for_lead=True, protocol_cycles=protocol, file_protocol_matches=file_protocol_matches, canonical_state_unchanged=True, notice_toggle_local_only=True, consent_off_on_reenable_unknown=True, new_visit_notices_off=True, safe_back_default_after_redraw=True, locked_return_same_ssh=True, notice_cells_max=39, main_open_hint='O', **({'files_open_hint': 'E'} if a.shared_files else {}))
        require_capture_association(input_association, trace_association, result)
        raw_result = (json.dumps(result, indent=2) + '\n').encode()
        save('capture-result-association.private.json', json.dumps(dict(capture_id=capture_id, source_sha256=source_hash, result_sha256=hashlib.sha256(raw_result).hexdigest(), **hashes)))
        return result
    finally:
        if trace is not None:
            try: save('board-io-failure.private.log', remote(TRACE_STOP.replace('issue230-board-', 'issue239-board-'), json.dumps(trace).encode()))
            except (AssertionError, subprocess.SubprocessError): pass
        if visit is not None:
            try:
                if visit_processes(visit['client']) == visit: os.kill(visit['ssh'], 15)
            except (AssertionError, ChildProcessError, ProcessLookupError): pass
        for i, child in enumerate(children): save('terminal-' + str(i) + '.private', child.transcript + child.buffer); child.close()


def main():
    p = argparse.ArgumentParser(description=__doc__)
    for name in ['client', 'fixture', 'owned-root', 'output', 'settings', 'mail-fixture', 'public-ca']: p.add_argument('--' + name, type=Path, required=True)
    p.add_argument('--capture-id', required=True)
    p.add_argument('--unicode', action='store_true'); p.add_argument('--shared-files', action='store_true')
    a = p.parse_args(); result = probe_main_menu(a)
    a.output.write_text(json.dumps(result, indent=2) + '\n')
    print('Owned same-SSH mail-notice controls passed:', result['count'], result['platform'])


if __name__ == '__main__': main()
