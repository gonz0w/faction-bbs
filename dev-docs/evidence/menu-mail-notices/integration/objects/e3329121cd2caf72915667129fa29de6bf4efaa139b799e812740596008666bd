def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def ref(p):return dict(path=str(p.relative_to(C)),sha256=sha(p))
def raw(v):
    path=Path(v['path']);assert not path.is_absolute() and '..' not in path.parts
    p=C/path if (C/path).exists() else R/path
    assert not p.is_symlink() and sha(p)==v['sha256'],str(path)
    return p.read_bytes()
