#!/bin/sh
# PROVIDE: faction_broker
# REQUIRE: DAEMON
# BEFORE: faction_sshd
# KEYWORD: shutdown

. /etc/rc.subr
name="faction_broker"
rcvar=$name
command="/usr/local/libexec/faction-broker"
pidfile="/var/run/faction/terminal.pid"
start_cmd="faction_start"
stop_cmd="faction_stop"
required_files="/var/db/faction/faction.sqlite3 /usr/local/libexec/faction-member"

faction_start()
{
    [ -z "$(check_pidfile "$pidfile" "$command")" ] || return 1
    [ ! -L /var/run/faction ] || return 1
    /usr/bin/install -d -o factiond -g factionipc -m 710 /var/run/faction || return 1
    terminal_uid=$(/usr/bin/id -u factionterm) || return 1
    # Configuration is root-owned shell configuration, as with other rc.d services.
    # Broker writes its own locked pidfile; $! here would identify su, not broker.
    /usr/bin/su -m factiond -c "exec $command --socket /var/run/faction/terminal.sock --terminal-uid $terminal_uid --worker /usr/local/libexec/faction-member --state-dir /var/db/faction $faction_broker_flags" </dev/null >>/var/log/faction-broker.log 2>&1 &
    n=0
    while [ "$n" -lt 50 ]; do
        if [ -n "$(check_pidfile "$pidfile" "$command")" ] && [ -S /var/run/faction/terminal.sock ]; then return 0; fi
        sleep 0.1
        n=$((n+1))
    done
    warn "broker did not become ready; inspect /var/log/faction-broker.log"
    return 1
}

faction_stop()
{
    p=$(check_pidfile "$pidfile" "$command")
    [ -n "$p" ] || return 0
    kill -TERM "$p" || return 1
    n=0
    while [ "$n" -lt 100 ]; do
        [ -z "$(check_pidfile "$pidfile" "$command")" ] && return 0
        sleep 0.1
        n=$((n+1))
    done
    warn "broker still running; inspect it before explicit forced recovery"
    return 1
}

load_rc_config "$name"
: ${faction_broker:=NO}
: ${faction_broker_flags:=}
run_rc_command "$1"
