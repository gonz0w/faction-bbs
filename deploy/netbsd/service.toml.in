# Root-owned mode 0644 or 0640; readable by factiond, never writable by members.
version = 1
terminal_uid = @FACTION_TERMINAL_UID@
socket = "/var/run/faction/terminal.sock"
state_dir = "/var/db/faction"
max_sessions = 8
launch_ms = 5000
session_seconds = 1800
ansi = true
experimental_capacity = false
# Optional owner-owned validated packs; load once at service start.
# theme = "/var/db/faction/themes/base"
# season = "/var/db/faction/themes/seasons/winter" # manual wins over schedule
# directory = "/var/db/faction/boards" # optional curated Other BBSes pack
# theme_schedule = "/var/db/faction/themes/seasons" # reads schedule.toml

# Optional read-only local OS-operator dashboard snapshot, private to state owner.
# operator_status = true
