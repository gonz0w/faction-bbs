* text=auto
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
dev-docs/archive/** -text

# Preserve the exact measured theme fixture, including its trailing blank line.
experiments/055-shared-ui/fixtures/base/theme.toml whitespace=-blank-at-eof

# Frozen executed build inputs retain exact bytes.
dev-docs/evidence/sources/** -text whitespace=-blank-at-eof,-blank-at-eol

# Preserve rejected executed inputs; collapse generated matrices in GitHub review.
dev-docs/evidence/admission-ledger/** -text
dev-docs/evidence/ssh-inetd/** -text
dev-docs/research/results/*.json linguist-generated=true

# Unified-diff context preserves upstream tabs and mandatory prefix spaces.
dev-docs/compatibility/*.patch whitespace=-blank-at-eol,-space-before-tab

# Historical source copies are generated evidence, not new runtime implementation.
dev-docs/evidence/sources/** linguist-generated=true
# A unified diff's required context prefix may precede upstream indentation tabs.
dev-docs/evidence/sources/*/dev-docs/compatibility/*.patch whitespace=-blank-at-eol,-space-before-tab

# Article fixtures retain protocol-mandated CRLF bytes.
crates/faction-articles/tests/fixtures/*.article -text whitespace=cr-at-eol

# Preserve the exact executed terminal compatibility baseline.
dev-docs/evidence/sources/pre25/** -text

dev-docs/evidence/sources/pre25-calendar/** -text

# ANSI templates preserve authored CRLF and canonical import bytes.
themes/seasons/**/*.ans -text whitespace=cr-at-eol

# Preserve executed seasonal art/source bytes before custom layout work.
dev-docs/evidence/sources/pre25-layouts/** -text
